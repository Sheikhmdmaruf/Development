# Connect the portfolio to the admin dashboard (Portfolio Admin).
# Copy this file to .env.local and fill in the values from
# Dashboard → Websites → (your portfolio).
#
# Without these, the site uses the built-in content in src/data
# and the contact form opens the visitor's email app.

# Where the dashboard runs, e.g. https://admin.maruf.design (no trailing slash)
VITE_ADMIN_API_URL=http://localhost:5180

# The PUBLIC site key (pk_live_...). It is safe in browser code: it only works
# from the "Allowed origins" you set for the website, and only for sending
# inquiries and reading published content. Never put the secret sk_ key here.
VITE_SITE_KEY=
