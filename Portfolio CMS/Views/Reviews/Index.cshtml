@model List<Review>
@{ ViewData["Title"] = "Reviews"; }
<div class="head">
    <div><div class="crumb">Content</div><h1>Reviews <span class="muted" style="font-weight:400">· @Model.Count</span></h1></div>
    <div class="actions"><partial name="_ViewToggle" /><a class="btn primary" href="/reviews/create">New review</a></div>
</div>

<div class="views" data-views="reviews" data-view="list">
    <script>try{if(localStorage.getItem('cms-view-reviews')==='grid')document.currentScript.parentElement.dataset.view='grid'}catch(e){}</script>
    @if (Model.Count == 0) { <div class="panel empty">No reviews yet.</div> }
    else
    {
        <div class="view-list panel table-wrap">
            <table class="table">
                <thead><tr><th>Client</th><th class="hide-sm">Quote</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td><div class="cell-flex"><span class="avatar" style="background:linear-gradient(135deg,@r.ColorA,@r.ColorB)"></span><div><a class="title" href="/reviews/edit/@r.Id">@r.Name</a><div class="sub">@r.Role · @r.Company</div></div></div></td>
                        <td class="hide-sm"><div class="sub">“@r.Quote”</div></td>
                        <td><partial name="_Status" model="r.IsPublished" /></td>
                        <td><partial name="_RowActions" model="(r.Id, r.IsPublished, r.Name)" /></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="view-grid cards">
            @foreach (var r in Model)
            {
                <div class="panel card">
                    <div class="card-body" style="gap:14px">
                        <p class="quote">“@r.Quote”</p>
                        <div class="cell-flex" style="margin-top:auto"><span class="avatar" style="background:linear-gradient(135deg,@r.ColorA,@r.ColorB)"></span><div><a class="card-title" href="/reviews/edit/@r.Id">@r.Name</a><div class="card-meta">@r.Role · @r.Company</div></div></div>
                    </div>
                    <div class="card-foot"><partial name="_Status" model="r.IsPublished" /><partial name="_RowActions" model="(r.Id, r.IsPublished, r.Name)" /></div>
                </div>
            }
        </div>
    }
</div>
