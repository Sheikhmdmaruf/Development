@model Review
@{ ViewData["Title"] = Model.Id == 0 ? "New review" : Model.Name; }
<div class="head"><div><div class="crumb"><a href="/reviews">Reviews</a> /</div><h1>@ViewData["Title"]</h1></div></div>
<form method="post">
    <div asp-validation-summary="ModelOnly"></div>
    <div class="panel"><div class="panel-body form-grid">
        <field for="Quote" kind="area" rows="3" />
        <field for="Name" span="4" />
        <field for="Role" span="4" />
        <field for="Company" span="4" />
        <field for="ColorA" span="3" kind="color" />
        <field for="ColorB" span="3" kind="color" />
        <field for="IsPublished" span="6" kind="check" />
        <input type="hidden" name="SortOrder" value="@Model.SortOrder" />
    </div></div>
    <partial name="_SaveBar" model="Model" />
</form>
<partial name="_DeleteForm" model="(Model.Id, Model.Name)" />
