@model Dictionary<string, string>
@using PortfolioCms.Data
@{
    var page = (string)ViewBag.Page;            // "home" or "about"
    var isHome = page == "home";
    ViewData["Title"] = isHome ? "Home page" : "About page";
    var siteUrl = isHome ? "http://localhost:5173/" : "http://localhost:5173/about";
    string V(string key) => Model.TryGetValue(key, out var v) ? v : "";
}
<div class="head">
    <div><div class="crumb">Pages</div><h1>@ViewData["Title"]</h1></div>
    <div class="actions">
        @if (!isHome) { <a class="btn" href="/experience">Edit Experience</a> }
        <a class="btn" href="@siteUrl" target="_blank" rel="noopener">View on website ↗</a>
    </div>
</div>
<p class="muted small" style="margin:-8px 0 14px">
    The top section of the @(isHome ? "Home" : "About") page. Leave a box empty to use the website's built-in text.
</p>

<form method="post" action="@(isHome ? "/hero" : "/hero/about")" asp-antiforgery="true">
    @foreach (var (_, group, fields) in Seeder.HeroGroups.Where(g => g.Page == page))
    {
        <div class="panel">
            <div class="panel-head"><h2>@group</h2></div>
            <div class="panel-body form-grid">
                @foreach (var f in fields)
                {
                    var name = $"values[{f.Key}]";
                    var span = f.Kind == "area" || f.Kind == "image" ? "f" : (f.Key.StartsWith("stat") ? "f s4" : "f s6");
                    <div class="@span">
                        <label for="@f.Key">@f.Label @if (!string.IsNullOrEmpty(f.Hint)) { <span class="hint">— @f.Hint</span> }</label>
                        @if (f.Kind == "image")
                        {
                            @Html.Raw(Ui.Image(name, V(f.Key), "/uploads/… — click Upload"))
                        }
                        else if (f.Kind == "area")
                        {
                            <textarea id="@f.Key" name="@name" rows="3" maxlength="1000">@V(f.Key)</textarea>
                        }
                        else
                        {
                            <input type="text" id="@f.Key" name="@name" value="@V(f.Key)" maxlength="1000" placeholder="@f.Default" />
                        }
                    </div>
                }
            </div>
        </div>
    }
    <div class="sticky-save">
        <span class="muted small">Changes show on the website on its next page load.</span>
        <button class="btn primary" type="submit">Save @(isHome ? "Home page" : "About page")</button>
    </div>
</form>
