@model List<Faq>
@{ ViewData["Title"] = "FAQ"; }
<div class="head">
    <div><div class="crumb">Content</div><h1>FAQ <span class="muted" style="font-weight:400">· @Model.Count</span></h1></div>
    <div class="actions"><partial name="_ViewToggle" /><a class="btn primary" href="/faq/create">New question</a></div>
</div>

<div class="views" data-views="faq" data-view="list">
    <script>try{if(localStorage.getItem('cms-view-faq')==='grid')document.currentScript.parentElement.dataset.view='grid'}catch(e){}</script>
    @if (Model.Count == 0) { <div class="panel empty">No questions yet.</div> }
    else
    {
        <div class="view-list panel table-wrap">
            <table class="table">
                <thead><tr><th>Question</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td><span class="pill accent">@f.Pill</span> <a class="title" href="/faq/edit/@f.Id">@f.Question</a><div class="sub">@f.Answer</div></td>
                        <td><partial name="_Status" model="f.IsPublished" /></td>
                        <td><partial name="_RowActions" model="(f.Id, f.IsPublished, f.Question)" /></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="view-grid cards">
            @foreach (var f in Model)
            {
                <div class="panel card">
                    <div class="card-body" style="gap:8px">
                        <span><span class="pill accent">@f.Pill</span></span>
                        <a class="card-title" href="/faq/edit/@f.Id">@f.Question</a>
                        <p class="card-text">@f.Answer</p>
                    </div>
                    <div class="card-foot"><partial name="_Status" model="f.IsPublished" /><partial name="_RowActions" model="(f.Id, f.IsPublished, f.Question)" /></div>
                </div>
            }
        </div>
    }
</div>
