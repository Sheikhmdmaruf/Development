@model List<Project>
@{
    ViewData["Title"] = "Work";
    string Bg(Project p) => !string.IsNullOrEmpty(p.ImageUrl) && p.ImageUrl.StartsWith("/uploads/")
        ? $"background-image:url('{p.ImageUrl}')" : $"background:linear-gradient(135deg,{p.Color1},{p.Color2})";
}
<div class="head">
    <div><div class="crumb">Content</div><h1>Work <span class="muted" style="font-weight:400">· @Model.Count projects</span></h1></div>
    <div class="actions"><partial name="_ViewToggle" /><a class="btn primary" href="/projects/create">New project</a></div>
</div>
<p class="muted small" style="margin:-8px 0 14px">The first 3 published projects show on the home page. Use ↑ ↓ to change the order.</p>

<div class="views" data-views="projects" data-view="list">
    <script>try{if(localStorage.getItem('cms-view-projects')==='grid')document.currentScript.parentElement.dataset.view='grid'}catch(e){}</script>
    @if (Model.Count == 0) { <div class="panel empty">No projects yet.</div> }
    else
    {
        <div class="view-list panel table-wrap">
            <table class="table">
                <thead><tr><th>Project</th><th class="hide-sm">Type</th><th class="hide-sm">Year</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><div class="cell-flex"><span class="thumb" style="@Bg(p)"></span><div><a class="title" href="/projects/edit/@p.Id">@p.Title</a>@if (!string.IsNullOrEmpty(p.Badge)) { <span class="pill accent" style="margin-left:6px">@p.Badge</span> }<div class="sub">@p.Summary</div></div></div></td>
                        <td class="hide-sm">@p.Category</td>
                        <td class="hide-sm">@p.Year</td>
                        <td><partial name="_Status" model="p.IsPublished" /></td>
                        <td><partial name="_RowActions" model="(p.Id, p.IsPublished, p.Title)" /></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="view-grid cards">
            @foreach (var p in Model)
            {
                <div class="panel card">
                    <a class="card-media" href="/projects/edit/@p.Id" style="@Bg(p)">@if (!string.IsNullOrEmpty(p.Badge)) { <span class="pill">@p.Badge</span> }</a>
                    <div class="card-body">
                        <span class="card-meta">@p.Category · @p.Year</span>
                        <a class="card-title" href="/projects/edit/@p.Id">@p.Title</a>
                        <p class="card-text">@p.Summary</p>
                    </div>
                    <div class="card-foot"><partial name="_Status" model="p.IsPublished" /><partial name="_RowActions" model="(p.Id, p.IsPublished, p.Title)" /></div>
                </div>
            }
        </div>
    }
</div>
