@model List<Post>
@{
    ViewData["Title"] = "Blog";
    string Bg(Post p) => p.ImageUrl?.StartsWith("/uploads/") == true
        ? $"background-image:url('{p.ImageUrl}')" : $"background:linear-gradient(135deg,{p.Color1},{p.Color2})";
    string Sub(Post p) => string.IsNullOrEmpty(p.ExternalUrl) ? p.ReadTime + " read" : "Outside link ↗";
}
<div class="head">
    <div><div class="crumb">Content</div><h1>Blog <span class="muted" style="font-weight:400">· @Model.Count posts</span></h1></div>
    <div class="actions"><partial name="_ViewToggle" /><a class="btn primary" href="/posts/create">New post</a></div>
</div>
<p class="muted small" style="margin:-8px 0 14px">Posts are sorted by date, newest first. The newest 3 show on the home page.</p>

<div class="views" data-views="posts" data-view="list">
    <script>try{if(localStorage.getItem('cms-view-posts')==='grid')document.currentScript.parentElement.dataset.view='grid'}catch(e){}</script>
    @if (Model.Count == 0) { <div class="panel empty">No posts yet.</div> }
    else
    {
        <div class="view-list panel table-wrap">
            <table class="table">
                <thead><tr><th>Post</th><th class="hide-sm">Category</th><th class="hide-sm">Date</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><div class="cell-flex"><span class="thumb" style="@Bg(p)"></span><div><a class="title" href="/posts/edit/@p.Id">@p.Title</a><div class="sub">@Sub(p)</div></div></div></td>
                        <td class="hide-sm">@p.Category</td>
                        <td class="hide-sm" style="white-space:nowrap">@p.PublishedOn.ToString("d MMM yyyy")</td>
                        <td><partial name="_Status" model="p.IsPublished" /></td>
                        <td><partial name="_PostActions" model="p" /></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="view-grid cards">
            @foreach (var p in Model)
            {
                <div class="panel card">
                    <a class="card-media" href="/posts/edit/@p.Id" style="@Bg(p)"><span class="pill">@p.Category</span></a>
                    <div class="card-body">
                        <span class="card-meta">@p.PublishedOn.ToString("d MMM yyyy") · @Sub(p)</span>
                        <a class="card-title" href="/posts/edit/@p.Id">@p.Title</a>
                    </div>
                    <div class="card-foot"><partial name="_Status" model="p.IsPublished" /><partial name="_PostActions" model="p" /></div>
                </div>
            }
        </div>
    }
</div>
