@{
    ViewData["Title"] = "Calendar";
    const string svg = "viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"";
}
<link rel="stylesheet" href="~/css/calendar.css" asp-append-version="true" />

<div class="cal" data-cal>
    <aside class="cal-side" data-cal-side>
        <button type="button" class="cal-create" data-act="create">
            @Html.Raw($"<svg {svg}><path d=\"M12 5v14M5 12h14\"/></svg>")<span>Create</span>
        </button>
        <div class="mini" data-mini></div>
        <div class="cal-lists">
            <div class="cal-lists-head">
                <span>My calendars</span>
                <button type="button" class="cl-btn" data-act="new-cal" title="Add a calendar" aria-label="Add a calendar">@Html.Raw($"<svg {svg}><path d=\"M12 5v14M5 12h14\"/></svg>")</button>
            </div>
            <div data-cal-lists></div>
        </div>
        <div class="cal-keys">
            <b>Shortcuts</b>
            <span><kbd>C</kbd> new event</span><span><kbd>T</kbd> today</span>
            <span><kbd>J</kbd>/<kbd>K</kbd> next / back</span><span><kbd>D</kbd> <kbd>W</kbd> <kbd>M</kbd> <kbd>A</kbd> views</span>
            <span><kbd>/</kbd> search</span>
        </div>
    </aside>
    <div class="cal-scrim" data-act="side"></div>

    <section class="cal-main panel">
        <div class="cal-bar">
            <button type="button" class="icon-btn cal-side-btn" data-act="side" aria-label="Show calendars">@Html.Raw($"<svg {svg}><path d=\"M4 6h16M4 12h16M4 18h16\"/></svg>")</button>
            <button type="button" class="btn" data-act="today">Today</button>
            <div class="cal-nav">
                <button type="button" class="icon-btn" data-act="prev" aria-label="Previous">@Html.Raw($"<svg {svg}><path d=\"m15 18-6-6 6-6\"/></svg>")</button>
                <button type="button" class="icon-btn" data-act="next" aria-label="Next">@Html.Raw($"<svg {svg}><path d=\"m9 18 6-6-6-6\"/></svg>")</button>
            </div>
            <h1 class="cal-title" data-title></h1>
            <div class="cal-search">
                @Html.Raw($"<svg {svg}><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/></svg>")
                <input type="search" placeholder="Search events" aria-label="Search events" data-search autocomplete="off" />
            </div>
            <div class="seg" role="tablist" aria-label="View">
                <button type="button" data-view="day">Day</button>
                <button type="button" data-view="week">Week</button>
                <button type="button" data-view="month">Month</button>
                <button type="button" data-view="schedule">Schedule</button>
            </div>
        </div>
        <div class="cal-body" data-body></div>
    </section>
</div>

@* Small floating card: quick create, event details, "+3 more" lists. Filled by calendar.js. *@
<div class="cal-pop" data-pop hidden role="dialog" aria-modal="false"></div>

@* Full event editor *@
<div class="modal" data-editor hidden role="dialog" aria-modal="true" aria-labelledby="edTitle">
    <form class="modal-box cal-editor" data-editor-form autocomplete="off">
        <div class="ed-head">
            <h2 id="edTitle" data-ed-heading>New event</h2>
            <button type="button" class="icon-btn" data-ed-close aria-label="Close">@Html.Raw($"<svg {svg}><path d=\"M6 6l12 12M18 6 6 18\"/></svg>")</button>
        </div>
        <div class="ed-body">
            <input type="text" class="ed-title" name="title" placeholder="Add title" maxlength="200" aria-label="Title" />
            <div class="ed-row">
                <span class="ed-ico">@Html.Raw($"<svg {svg}><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>")</span>
                <div class="ed-when">
                    <div class="ed-dt">
                        <input type="date" name="startDate" aria-label="Start date" required />
                        <input type="time" name="startTime" step="900" aria-label="Start time" data-timed />
                        <span class="muted">to</span>
                        <input type="time" name="endTime" step="900" aria-label="End time" data-timed />
                        <input type="date" name="endDate" aria-label="End date" required />
                    </div>
                    <div class="ed-dt">
                        <label class="check"><input type="checkbox" name="allDay" /> All day</label>
                        <select name="repeat" aria-label="Repeat" data-repeat></select>
                        <label class="ed-until" data-until-wrap>until <input type="date" name="repeatUntil" aria-label="Repeat until" /></label>
                    </div>
                    <p class="hint" data-series-hint hidden>This is a repeating event. Changes apply to every repeat.</p>
                </div>
            </div>
            <div class="ed-row">
                <span class="ed-ico">@Html.Raw($"<svg {svg}><path d=\"M12 21s-7-6.1-7-11.5A7 7 0 0 1 19 9.5C19 14.9 12 21 12 21z\"/><circle cx=\"12\" cy=\"9.5\" r=\"2.5\"/></svg>")</span>
                <input type="text" name="location" placeholder="Add location or meeting link" maxlength="300" aria-label="Location" />
            </div>
            <div class="ed-row">
                <span class="ed-ico">@Html.Raw($"<svg {svg}><path d=\"M4 6h16M4 12h16M4 18h10\"/></svg>")</span>
                <textarea name="description" placeholder="Add description" maxlength="4000" rows="3" aria-label="Description"></textarea>
            </div>
            <div class="ed-row">
                <span class="ed-ico">@Html.Raw($"<svg {svg}><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M3 10h18M8 3v4M16 3v4\"/></svg>")</span>
                <div class="ed-cal">
                    <select name="calendarId" aria-label="Calendar" data-cal-select></select>
                    <div class="swatches" data-ed-colors role="radiogroup" aria-label="Event colour"></div>
                </div>
            </div>
            <p class="ed-error" data-ed-error hidden></p>
        </div>
        <div class="modal-foot ed-foot">
            <button type="button" class="btn danger" data-ed-delete hidden>Delete</button>
            <span class="grow"></span>
            <button type="button" class="btn" data-ed-close>Cancel</button>
            <button type="submit" class="btn primary">Save</button>
        </div>
    </form>
</div>

@* Add / edit a calendar *@
<div class="modal" data-calmodal hidden role="dialog" aria-modal="true" aria-labelledby="cmTitle">
    <form class="modal-box cal-editor small" data-calmodal-form autocomplete="off">
        <div class="ed-head">
            <h2 id="cmTitle" data-cm-heading>New calendar</h2>
            <button type="button" class="icon-btn" data-cm-close aria-label="Close">@Html.Raw($"<svg {svg}><path d=\"M6 6l12 12M18 6 6 18\"/></svg>")</button>
        </div>
        <div class="ed-body">
            <div class="f"><label for="cmName">Name</label><input id="cmName" type="text" name="name" maxlength="60" placeholder="e.g. Work, Gym, Client calls" required /></div>
            <div class="f"><span class="label">Colour</span><div class="swatches" data-cm-colors role="radiogroup" aria-label="Calendar colour"></div></div>
            <p class="ed-error" data-cm-error hidden></p>
        </div>
        <div class="modal-foot ed-foot">
            <button type="button" class="btn danger" data-cm-delete hidden>Delete calendar</button>
            <span class="grow"></span>
            <button type="button" class="btn" data-cm-close>Cancel</button>
            <button type="submit" class="btn primary">Save</button>
        </div>
    </form>
</div>

<script>window.CAL_INIT = @Json.Serialize(ViewBag.Calendars);</script>
<script src="~/js/calendar.js" asp-append-version="true"></script>
