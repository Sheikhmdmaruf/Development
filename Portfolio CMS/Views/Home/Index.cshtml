@model PortfolioCms.Controllers.DashboardVm
@{
    ViewData["Title"] = "Dashboard";
    const string svg = "viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"";
    var hour = DateTime.Now.Hour;
    var hello = hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";
    string Sub((int Total, int Hidden) c, string word) =>
        c.Hidden == 0 ? $"<b>{c.Total}</b> {word}" : $"<b>{c.Total - c.Hidden}</b> live · {c.Hidden} hidden";
    string Ago(DateTime utc)
    {
        var d = DateTime.UtcNow - utc;
        return d.TotalMinutes < 1 ? "just now" : d.TotalHours < 1 ? $"{(int)d.TotalMinutes} min ago"
             : d.TotalDays < 1 ? $"{(int)d.TotalHours} h ago" : d.TotalDays < 7 ? $"{(int)d.TotalDays} d ago"
             : utc.ToLocalTime().ToString("d MMM");
    }
}
<div class="head">
    <div>
        <div class="crumb">@DateTime.Now.ToString("dddd, d MMMM") · <time class="clock" data-clock>@DateTime.Now.ToString("h:mm:ss tt")</time> · @hello, @User.Identity?.Name</div>
        <h1>Your portfolio, <span class="accent-word">today</span></h1>
        <p class="muted" style="margin-top:6px">Everything on your website in one place. Edit content, check messages and fix what needs attention.</p>
    </div>
    <div class="actions">
        <a class="btn" href="/posts/create">@Html.Raw($"<svg {svg}><path d=\"M4 20h4L19 9l-4-4L4 16z\"/></svg>")New post</a>
        <a class="btn primary" href="/projects/create">@Html.Raw($"<svg {svg}><path d=\"M12 5v14M5 12h14\"/></svg>")New project</a>
    </div>
</div>

<div class="kpis">
    <a class="panel kpi" href="/projects">
        <div class="kpi-top">Projects <span class="kpi-ico">@Html.Raw($"<svg {svg}><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/></svg>")</span></div>
        <div class="kpi-val">@Model.Projects.Total</div>
        <div class="kpi-cap">@Html.Raw(Sub(Model.Projects, "on the Work page"))</div>
    </a>
    <a class="panel kpi" href="/services">
        <div class="kpi-top">Services <span class="kpi-ico">@Html.Raw($"<svg {svg}><path d=\"M12 3l2.6 5.6L20 9.5l-4 4 1 5.8-5-2.8-5 2.8 1-5.8-4-4 5.4-.9z\"/></svg>")</span></div>
        <div class="kpi-val">@Model.Services.Total</div>
        <div class="kpi-cap">@Html.Raw(Sub(Model.Services, "offered"))</div>
    </a>
    <a class="panel kpi" href="/posts">
        <div class="kpi-top">Blog posts <span class="kpi-ico">@Html.Raw($"<svg {svg}><path d=\"M4 20h4L19 9l-4-4L4 16z\"/><path d=\"M13.5 6.5l4 4\"/></svg>")</span></div>
        <div class="kpi-val">@Model.Posts.Total</div>
        <div class="kpi-cap">@if (Model.LatestPost is DateTime lp) { <span>Latest <b>@lp.ToString("d MMM yyyy")</b></span> } else { <span>No posts yet</span> }</div>
    </a>
    <a class="panel kpi" href="/reviews">
        <div class="kpi-top">Reviews <span class="kpi-ico ok">@Html.Raw($"<svg {svg}><path d=\"M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z\"/></svg>")</span></div>
        <div class="kpi-val">@Model.Reviews.Total</div>
        <div class="kpi-cap">@Html.Raw(Sub(Model.Reviews, "shown"))</div>
    </a>
    <a class="panel kpi" href="/inbox">
        <div class="kpi-top">Unread messages <span class="kpi-ico warm">@Html.Raw($"<svg {svg}><path d=\"M3 13h5l1.5 3h5L16 13h5\"/><path d=\"M5 5h14l2 8v6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-6z\"/></svg>")</span></div>
        <div class="kpi-val">@Model.Unread</div>
        <div class="kpi-cap"><b>@Model.Messages</b> message@(Model.Messages == 1 ? "" : "s") in total</div>
    </a>
</div>

@{
    var cal = Model.Calendar;
    var now = DateTime.Now;
    var nextIdx = cal.Today.FindIndex(a => !a.AllDay && a.Start > now);
    string When(PortfolioCms.Controllers.AgendaItem a, DateTime day)
    {
        if (a.AllDay || (a.Start <= day && a.End >= day.AddDays(1))) return "All day";
        if (a.Start < day) return "Until " + a.End.ToString("h:mm tt");
        if (a.End > day.AddDays(1)) return a.Start.ToString("h:mm tt") + " →";
        return $"{a.Start:h:mm} – {a.End:h:mm tt}";
    }
    string In(DateTime start)
    {
        var d = start - now;
        return d.TotalMinutes < 60 ? $"In {(int)Math.Ceiling(d.TotalMinutes)} min" : d.Minutes == 0 ? $"In {(int)d.TotalHours} h" : $"In {(int)d.TotalHours} h {d.Minutes} min";
    }
    string DayLink(DateTime d) => "/calendar#/day/" + d.ToString("yyyy-MM-dd");
}
<div class="panel cal-sum">
    <div class="panel-head">
        <h2>Calendar <span class="pill" style="margin-left:6px">@cal.WeekCount event@(cal.WeekCount == 1 ? "" : "s") in the next 7 days</span></h2>
        <div style="display:flex;gap:12px;align-items:center">
            <a class="btn sm" href="/calendar?new=1">@Html.Raw($"<svg {svg}><path d=\"M12 5v14M5 12h14\"/></svg>")New event</a>
            <span class="small"><a href="/calendar">Open calendar</a></span>
        </div>
    </div>
    <div class="cs-grid">
        <div class="cs-today">
            <div class="cs-label">Today · @now.ToString("ddd d MMM")</div>
            @if (cal.Today.Count == 0)
            {
                <div class="cs-empty">Nothing scheduled today. <a href="/calendar?new=1">Add an event</a></div>
            }
            else
            {
                for (var i = 0; i < cal.Today.Count; i++)
                {
                    var a = cal.Today[i];
                    var live = !a.AllDay && a.Start <= now && a.End > now;
                    var past = !a.AllDay && a.End <= now;
                    <a class="cs-ev @(past ? "past" : "") @(live ? "live" : "")" href="@DayLink(now.Date)" style="--c:@a.Color">
                        <span class="cs-time">@When(a, now.Date)</span>
                        <span class="cs-bar"></span>
                        <span class="cs-text"><b>@a.Title</b><span>@(string.IsNullOrEmpty(a.Location) ? a.CalendarName : a.Location + " · " + a.CalendarName)</span></span>
                        @if (live) { <span class="pill ok">Now</span> }
                        else if (i == nextIdx) { <span class="pill accent">@In(a.Start)</span> }
                    </a>
                }
            }
        </div>
        <div class="cs-side">
            <div class="cs-week">
                @foreach (var w in cal.Week)
                {
                    <a class="cs-day @(w.Day == now.Date ? "today" : "")" href="@DayLink(w.Day)" title="@w.Day.ToString("dddd d MMMM") · @w.Count event@(w.Count == 1 ? "" : "s")">
                        <span class="cs-dow">@w.Day.ToString("ddd")</span>
                        <b>@w.Day.Day</b>
                        <span class="cs-dots">@foreach (var c in w.Colors) { <i style="--c:@c"></i> }</span>
                        <span class="cs-count">@(w.Count == 0 ? "Free" : w.Count.ToString())</span>
                    </a>
                }
            </div>
            <div class="cs-label">Coming up</div>
            @if (cal.Upcoming.Count == 0)
            {
                <div class="cs-empty">Nothing planned in the next two weeks.</div>
            }
            else
            {
                <div class="cs-up">
                    @foreach (var a in cal.Upcoming)
                    {
                        <a class="cs-up-row" href="@DayLink(a.Start.Date)" style="--c:@a.Color">
                            <span class="cs-date"><b>@a.Start.Day</b>@a.Start.ToString("MMM")</span>
                            <i class="cs-dot"></i>
                            <span class="cs-text"><b>@a.Title</b><span>@a.Start.ToString("dddd") · @(a.AllDay ? "All day" : a.Start.ToString("h:mm tt"))</span></span>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="dash-grid">
    <div class="panel">
        <div class="panel-head"><h2>Needs your attention</h2><span class="pill">@Model.Attention.Count(a => a.Tone != "ok")</span></div>
        <div class="todo">
            @foreach (var a in Model.Attention)
            {
                var icon = a.Tone switch
                {
                    "warm" => "<path d=\"M3 13h5l1.5 3h5L16 13h5\"/><path d=\"M5 5h14l2 8v6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-6z\"/>",
                    "warn" => "<path d=\"M12 9v4M12 17h.01\"/><path d=\"M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z\"/>",
                    "ok" => "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"m8 12 3 3 5-6\"/>",
                    _ => "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 8v4M12 16h.01\"/>",
                };
                <a class="todo-row" href="@a.Href">
                    <span class="todo-dot @a.Tone">@Html.Raw($"<svg {svg}>{icon}</svg>")</span>
                    <span class="todo-text"><b>@a.Title</b><span>@a.Detail</span></span>
                    @if (a.Tone != "ok") { <span class="todo-go">@a.Go →</span> }
                </a>
            }
        </div>
    </div>

    <div class="panel">
        <div class="panel-head"><h2>Latest messages</h2><span class="small"><a href="/inbox">View all</a></span></div>
        @if (Model.Latest.Count == 0)
        {
            <div class="empty">No messages yet. They arrive here from the contact form on your website.</div>
        }
        else
        {
            <div class="todo">
                @foreach (var s in Model.Latest)
                {
                    <a class="todo-row" href="/inbox/open/@s.Id">
                        <span class="initial" style="width:30px;height:30px;font-size:12px">@(s.Name.Length > 0 ? s.Name[..1].ToUpperInvariant() : "?")</span>
                        <span class="todo-text"><b>@s.Name @if (!s.IsRead) { <span class="pill accent" style="height:18px;font-size:10.5px;margin-left:4px">New</span> }</b><span style="display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@s.Message</span></span>
                        <span class="todo-go">@Ago(s.CreatedAt)</span>
                    </a>
                }
            </div>
        }
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Recently edited</h2><span class="small muted">Last 6 changes</span></div>
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>Title</th><th>Type</th><th style="text-align:right">Edited</th></tr></thead>
            <tbody>
            @foreach (var r in Model.Recent)
            {
                <tr>
                    <td><a class="title" href="/@r.Ctrl/edit/@r.Id">@r.Title</a></td>
                    <td><span class="pill">@r.Kind</span></td>
                    <td class="muted" style="text-align:right;white-space:nowrap">@Ago(r.UpdatedAt)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
