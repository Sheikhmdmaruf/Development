@model (int Id, bool Published, string Name)
@{ var c = ViewContext.RouteData.Values["controller"]; }
<div class="actions">
    @* Arrows are SVG icons (not ↑ ↓ text) so they sit exactly in the middle of the button. *@
    <form asp-antiforgery="true" class="inline" method="post" action="/@c/move/@Model.Id?dir=-1"><button class="btn sm icon" title="Move up" aria-label="Move up"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M6 11l6-6 6 6"/></svg></button></form>
    <form asp-antiforgery="true" class="inline" method="post" action="/@c/move/@Model.Id?dir=1"><button class="btn sm icon" title="Move down" aria-label="Move down"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg></button></form>
    <partial name="_EditActions" model="(c?.ToString() ?? string.Empty, Model.Id, Model.Published, Model.Name)" />
</div>
