@model (int Id, bool Published, string Name)
@{ var c = ViewContext.RouteData.Values["controller"]; }
<div class="actions">
    <form asp-antiforgery="true" class="inline" method="post" action="/@c/move/@Model.Id?dir=-1"><button class="btn sm icon" title="Move up" aria-label="Move up">↑</button></form>
    <form asp-antiforgery="true" class="inline" method="post" action="/@c/move/@Model.Id?dir=1"><button class="btn sm icon" title="Move down" aria-label="Move down">↓</button></form>
    <partial name="_EditActions" model="(c?.ToString() ?? string.Empty, Model.Id, Model.Published, Model.Name)" />
</div>
