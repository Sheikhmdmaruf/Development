@inject PortfolioCms.Data.CmsDbContext Db
@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var unread = Db.Submissions.Count(s => !s.IsRead);
    var act = ViewContext.RouteData.Values["action"]?.ToString();
    string On(string c) => string.Equals(ctrl, c, StringComparison.OrdinalIgnoreCase) ? "on" : "";
    // Home page / About page menus share the Hero controller, so they also check the action.
    string OnPage(string a) => string.Equals(ctrl, "Hero", StringComparison.OrdinalIgnoreCase) && string.Equals(act, a, StringComparison.OrdinalIgnoreCase) ? "on" : "";
    const string svg = "viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"";
    var userName = User.Identity?.Name ?? "Admin";
    var initial = userName.Length > 0 ? userName[..1].ToUpperInvariant() : "A";
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t ? t + " · " : "")Portfolio CMS</title>
    @* Apply the saved light/dark choice before the page paints (no flash). *@
    <script>try{var t=localStorage.getItem('cms-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='9' fill='%233d7bff'/><text x='16' y='22' font-size='16' text-anchor='middle' fill='white' font-family='sans-serif' font-weight='700'>M</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="app">
        <aside class="side">
            <div class="brand"><i>M</i><div>Portfolio CMS<small>Sheikh Md Maruf</small></div></div>
            <nav class="nav">
                <a class="@On("Home")" href="/">@Html.Raw($"<svg {svg}><rect x=\"3\" y=\"3\" width=\"7\" height=\"9\" rx=\"1.5\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\" rx=\"1.5\"/><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\" rx=\"1.5\"/><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\" rx=\"1.5\"/></svg>")Dashboard</a>
                <a class="@On("Inbox")" href="/inbox">@Html.Raw($"<svg {svg}><path d=\"M3 13h5l1.5 3h5L16 13h5\"/><path d=\"M5 5h14l2 8v6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-6z\"/></svg>")Inbox @if (unread > 0) { <span class="count">@unread</span> }</a>

                <div class="nav-label">Pages</div>
                <a class="@OnPage("Index")" href="/hero">@Html.Raw($"<svg {svg}><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M7 9h6M7 12.5h10M7 16h4\"/></svg>")Hero</a>
                <a class="@OnPage("About")" href="/hero/about">@Html.Raw($"<svg {svg}><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21a8 8 0 0 1 16 0\"/></svg>")About</a>
                <a class="@On("Experience")" href="/experience">@Html.Raw($"<svg {svg}><rect x=\"3\" y=\"7\" width=\"18\" height=\"13\" rx=\"2\"/><path d=\"M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 13h18\"/></svg>")Experience</a>

                <div class="nav-label">Content</div>
                <a class="@On("Projects")" href="/projects">@Html.Raw($"<svg {svg}><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/></svg>")Work</a>
                <a class="@On("Services")" href="/services">@Html.Raw($"<svg {svg}><path d=\"M12 3l2.6 5.6L20 9.5l-4 4 1 5.8-5-2.8-5 2.8 1-5.8-4-4 5.4-.9z\"/></svg>")Services</a>
                <a class="@On("Posts")" href="/posts">@Html.Raw($"<svg {svg}><path d=\"M4 20h4L19 9l-4-4L4 16z\"/><path d=\"M13.5 6.5l4 4\"/></svg>")Blog</a>
                <a class="@On("Reviews")" href="/reviews">@Html.Raw($"<svg {svg}><path d=\"M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z\"/></svg>")Reviews</a>
                <a class="@On("Faq")" href="/faq">@Html.Raw($"<svg {svg}><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.6M12 17h.01\"/></svg>")FAQ</a>
                <a class="@On("Tools")" href="/tools">@Html.Raw($"<svg {svg}><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-.5-.5-2.5z\"/></svg>")Tools</a>

                <div class="nav-label">Site</div>
                <a class="@On("Social")" href="/social">@Html.Raw($"<svg {svg}><circle cx=\"18\" cy=\"5\" r=\"3\"/><circle cx=\"6\" cy=\"12\" r=\"3\"/><circle cx=\"18\" cy=\"19\" r=\"3\"/><path d=\"m8.6 13.5 6.8 4M15.4 6.5l-6.8 4\"/></svg>")Social links</a>
                <a class="@On("Media")" href="/media">@Html.Raw($"<svg {svg}><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><circle cx=\"9\" cy=\"10\" r=\"2\"/><path d=\"m21 16-5-5-9 9\"/></svg>")Media</a>
                <a class="@On("Settings")" href="/settings">@Html.Raw($"<svg {svg}><path d=\"M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6\"/></svg>")Site settings</a>
            </nav>
            <div class="side-foot">
                <div class="user-card">
                    <span class="initial">@initial</span>
                    <div class="who"><b>@userName</b><span>Administrator</span></div>
                    <a class="btn sm icon" href="/account/password" title="Change password" aria-label="Change password">@Html.Raw($"<svg {svg}><rect x=\"4\" y=\"11\" width=\"16\" height=\"10\" rx=\"2\"/><path d=\"M8 11V7a4 4 0 0 1 8 0v4\"/></svg>")</a>
                    <form asp-antiforgery="true" class="inline" method="post" action="/account/logout"><button class="btn sm icon" title="Log out" aria-label="Log out">@Html.Raw($"<svg {svg}><path d=\"M15 4h4a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-4M10 17l5-5-5-5M15 12H3\"/></svg>")</button></form>
                </div>
            </div>
        </aside>

        <div class="main-col">
            <header class="topbar">
                <button type="button" class="icon-btn menu-btn" data-menu aria-label="Open menu">@Html.Raw($"<svg {svg}><path d=\"M4 6h16M4 12h16M4 18h16\"/></svg>")</button>
                <button type="button" class="top-search" data-cmdk-open aria-label="Search or jump to">
                    @Html.Raw($"<svg {svg}><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/></svg>")
                    <span>Search or jump to…</span><kbd>Ctrl K</kbd>
                </button>
                <div class="top-right">
                    <a class="btn hide-mobile" href="http://localhost:5173" target="_blank" rel="noopener">@Html.Raw($"<svg {svg}><path d=\"M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5\"/></svg>")View website</a>
                    <a class="icon-btn" href="/inbox" title="Inbox" aria-label="Inbox">@Html.Raw($"<svg {svg}><path d=\"M6 8a6 6 0 0 1 12 0c0 7 3 8 3 8H3s3-1 3-8M10.3 21a1.9 1.9 0 0 0 3.4 0\"/></svg>")@if (unread > 0) { <span class="dot"></span> }</a>
                    <button type="button" class="icon-btn" data-theme-toggle title="Light / dark mode" aria-label="Switch light or dark mode">
                        <svg class="theme-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                        <svg class="theme-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                    </button>
                    <span class="initial" title="@userName">@initial</span>
                </div>
            </header>
            <main class="main">
                @RenderBody()
            </main>
        </div>
    </div>

    @* Command palette (Ctrl+K): the menu links are added by admin.js; these are quick actions. *@
    <div class="cmdk" data-cmdk role="dialog" aria-modal="true" aria-label="Search or jump to">
        <div class="cmdk-box">
            <div class="cmdk-input">@Html.Raw($"<svg {svg}><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/></svg>")<input type="search" placeholder="Type a page or action…" aria-label="Search" data-cmdk-input autocomplete="off" /></div>
            <div class="cmdk-list" data-cmdk-list></div>
            <div class="cmdk-foot"><span><kbd>↑</kbd> <kbd>↓</kbd> move</span><span><kbd>Enter</kbd> open</span><span><kbd>Esc</kbd> close</span></div>
        </div>
        <template data-cmdk-actions>
            <a href="/projects/create">New project</a>
            <a href="/posts/create">New blog post</a>
            <a href="/services/create">New service</a>
            <a href="/experience/create">New experience</a>
            <a href="/reviews/create">New review</a>
            <a href="/faq/create">New FAQ question</a>
            <a href="/tools/create">New tool</a>
            <a href="/social/create">New social link</a>
            <a href="/media">Upload an image</a>
            <a href="http://localhost:5173" data-external>Open the website</a>
        </template>
    </div>

    @* Confirm popup for delete (and other risky) buttons. admin.js fills it from the form that was clicked. *@
    <div class="modal" data-confirm-modal role="dialog" aria-modal="true" aria-labelledby="confirmTitle" hidden>
        <div class="modal-box">
            <div class="modal-head">
                <span class="modal-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg></span>
                <div>
                    <h2 id="confirmTitle" data-confirm-title>Delete this item?</h2>
                    <p class="muted small" data-confirm-text>This can't be undone.</p>
                </div>
            </div>
            <div class="modal-summary" data-confirm-summary>
                <div class="ms-media" data-confirm-media></div>
                <div class="ms-text">
                    <span class="ms-kind" data-confirm-kind></span>
                    <b data-confirm-name></b>
                    <span class="ms-sub" data-confirm-sub></span>
                </div>
                <span data-confirm-status></span>
            </div>
            <div class="modal-foot">
                <button type="button" class="btn" data-confirm-cancel>Cancel</button>
                <button type="button" class="btn btn-danger-solid" data-confirm-ok>Delete</button>
            </div>
        </div>
    </div>

    <div class="toasts" aria-live="polite">
        @if (TempData["ok"] is string ok)
        {
            <div class="toast ok" role="status">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg>
                <span>@ok</span>
                <button type="button" class="toast-close" aria-label="Close">×</button>
            </div>
        }
        @if (TempData["err"] is string err)
        {
            <div class="toast err" role="alert">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
                <span>@err</span>
                <button type="button" class="toast-close" aria-label="Close">×</button>
            </div>
        }
    </div>
    @Html.AntiForgeryToken()
    <script src="~/js/admin.js" asp-append-version="true"></script>
</body>
</html>
