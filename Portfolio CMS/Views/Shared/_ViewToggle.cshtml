@* List / Grid switch. The choice is remembered per page in the browser. *@
<div class="view-toggle" role="group" aria-label="Change view">
    <button type="button" class="vt-btn" data-view-set="list" aria-pressed="true" title="List view">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01"/></svg>
        <span>List</span>
    </button>
    <button type="button" class="vt-btn" data-view-set="grid" aria-pressed="false" title="Grid view">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
        <span>Grid</span>
    </button>
</div>
