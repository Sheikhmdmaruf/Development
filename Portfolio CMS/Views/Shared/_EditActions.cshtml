@model (string Controller, int Id, bool Published, string Name)
@* Hide/Publish, Edit and Delete. Each has an icon and a label; on narrow grid cards only the icon shows. *@
@{
    var c = Model.Controller;
    var toggle = Model.Published ? "Hide" : "Publish";
}
<form asp-antiforgery="true" class="inline" method="post" action="/@c/togglepublish/@Model.Id">
    <button class="btn sm" title="@toggle" aria-label="@toggle">
        @if (Model.Published)
        {
            <svg class="bi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l18 18M10.6 10.6a2 2 0 0 0 2.8 2.8M9.9 5.1A9.7 9.7 0 0 1 12 5c5 0 9 4.5 10 7a13 13 0 0 1-2.6 3.7M6.6 6.6C4.4 8 2.8 10 2 12c1 2.5 5 7 10 7 1.7 0 3.3-.5 4.7-1.3"/></svg>
        }
        else
        {
            <svg class="bi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12c1-2.5 5-7 10-7s9 4.5 10 7c-1 2.5-5 7-10 7S3 14.5 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
        }
        <span class="bl">@toggle</span>
    </button>
</form>
<a class="btn sm" href="/@c/edit/@Model.Id" title="Edit" aria-label="Edit">
    <svg class="bi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4L19 9l-4-4L4 16z"/><path d="M13.5 6.5l4 4"/></svg>
    <span class="bl">Edit</span>
</a>
<form asp-antiforgery="true" class="inline" method="post" action="/@c/delete/@Model.Id" data-confirm="Delete “@Model.Name”? This can't be undone." data-name="@Model.Name">
    <button class="btn sm danger" title="Delete" aria-label="Delete">
        <svg class="bi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg>
        <span class="bl">Delete</span>
    </button>
</form>
