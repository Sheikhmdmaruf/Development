@model PortfolioCms.Controllers.InboxVm
@{
    ViewData["Title"] = "Inbox";
    const string svg = "viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"";
    string I(string paths) => $"<svg {svg}>{paths}</svg>";
    var ic = new Dictionary<string, string>
    {
        ["inbox"] = "<path d=\"M3 13h5l1.5 3h5L16 13h5\"/><path d=\"M5 5h14l2 8v6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-6z\"/>",
        ["unread"] = "<rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"m3 7 9 6 9-6\"/>",
        ["flagged"] = "<path d=\"M5 21V4h11l-1.5 4L16 12H5\"/>",
        ["sent"] = "<path d=\"M22 2 11 13\"/><path d=\"M22 2 15 22l-4-9-9-4z\"/>",
        ["archive"] = "<rect x=\"3\" y=\"4\" width=\"18\" height=\"5\" rx=\"1\"/><path d=\"M5 9v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9M10 13h4\"/>",
        ["deleted"] = "<path d=\"M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3\"/>",
        ["reply"] = "<path d=\"M9 14 4 9l5-5\"/><path d=\"M4 9h10a6 6 0 0 1 6 6v5\"/>",
        ["forward"] = "<path d=\"m15 14 5-5-5-5\"/><path d=\"M20 9H10a6 6 0 0 0-6 6v5\"/>",
        ["new"] = "<path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z\"/>",
        ["gear"] = "<circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 2v3M12 19v3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1 7 17M17 7l2.1-2.1\"/>",
        ["search"] = "<circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/>",
        ["back"] = "<path d=\"m15 18-6-6 6-6\"/>",
        ["mailopen"] = "<path d=\"M3 10 12 4l9 6v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z\"/><path d=\"m3 10 9 6 9-6\"/>",
        ["restore"] = "<path d=\"M3 12a9 9 0 1 0 3-6.7L3 8\"/><path d=\"M3 3v5h5\"/>",
        ["check"] = "<path d=\"m5 12 5 5L20 7\"/>",
        ["warn"] = "<path d=\"M12 9v4M12 17h.01\"/><path d=\"M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z\"/>",
        ["clip"] = "<path d=\"m21 11-8.6 8.6a5 5 0 0 1-7-7L14 4a3.3 3.3 0 0 1 4.7 4.7l-8.6 8.6a1.7 1.7 0 0 1-2.4-2.4L15.5 7\"/>",
        ["download"] = "<path d=\"M12 4v12M7 11l5 5 5-5\"/><path d=\"M4 20h16\"/>",
    };
    string Ext(string name) { var e = System.IO.Path.GetExtension(name).TrimStart('.').ToUpperInvariant(); return e.Length > 4 ? e[..4] : e; }
    string FileKind(string name) => System.IO.Path.GetExtension(name).ToLowerInvariant() switch
    {
        ".jpg" or ".jpeg" or ".png" or ".gif" => "img",
        ".doc" or ".docx" => "doc",
        ".xls" or ".xlsx" => "xls",
        ".zip" or ".rar" => "zip",
        _ => "vid",
    };
    // Attachment chips with download links (file names are HTML-encoded with Ui.E).
    string FilesHtml(IEnumerable<MailAttachment> files) =>
        "<div class=\"ol-files\">" + string.Concat(files.Select(a =>
            $"<a class=\"oc-file dl\" href=\"/inbox/attachment/{a.Id}\" title=\"Download {Ui.E(a.FileName)}\"><span class=\"oc-ficon {FileKind(a.FileName)}\">{Ui.E(Ext(a.FileName))}</span><span class=\"oc-fname\"><b>{Ui.E(a.FileName)}</b><small>{MailFiles.Size(a.Size)}</small></span><span class=\"oc-fdl\">{I(ic["download"])}</span></a>")) + "</div>";
    var names = new Dictionary<string, string> { ["inbox"] = "Inbox", ["unread"] = "Unread", ["flagged"] = "Flagged", ["sent"] = "Sent items", ["archive"] = "Archive", ["deleted"] = "Deleted items" };
    string[] avatarColors = ["#3d7bff", "#e8590c", "#2b8a3e", "#ae3ec9", "#c2255c", "#0b7285", "#5f3dc4", "#d9480f", "#1971c2", "#087f5b"];
    string Avatar(string key) { var h = 0; foreach (var ch in key.ToLowerInvariant()) h = (h * 31 + ch) & 0x7fffffff; return avatarColors[h % avatarColors.Length]; }
    string Initials(string name)
    {
        var p = name.Replace("To: ", "").Split([' ', '<', '@'], StringSplitOptions.RemoveEmptyEntries);
        return p.Length == 0 ? "?" : p.Length == 1 ? p[0][..1].ToUpperInvariant() : (p[0][..1] + p[1][..1]).ToUpperInvariant();
    }
    var today = DateTime.Today;
    string Group(DateTime utc)
    {
        var d = utc.ToLocalTime().Date;
        var weekStart = today.AddDays(-(int)today.DayOfWeek);
        return d == today ? "Today" : d == today.AddDays(-1) ? "Yesterday" : d >= weekStart ? "Earlier this week"
            : d >= weekStart.AddDays(-7) ? "Last week" : d >= new DateTime(today.Year, today.Month, 1) ? "Earlier this month" : "Older";
    }
    string When(DateTime utc)
    {
        var l = utc.ToLocalTime();
        return l.Date == today ? l.ToString("h:mm tt") : (today - l.Date).TotalDays < 7 ? l.ToString("ddd h:mm tt") : l.Year == today.Year ? l.ToString("d MMM") : l.ToString("d MMM yyyy");
    }
    string Url(string? folder = null, int? id = null, string? compose = null, int? from = null)
    {
        var parts = new List<string> { "folder=" + (folder ?? Model.Folder) };
        if (id is int i) parts.Add("id=" + i);
        if (Model.Q is string q && folder is null) parts.Add("q=" + Uri.EscapeDataString(q));
        if (compose is not null) parts.Add("compose=" + compose);
        if (from is int fr) parts.Add("from=" + fr);
        return "/inbox?" + string.Join("&", parts);
    }
    var msg = Model.Message; var sent = Model.Sent; var compose = Model.Compose;
    var selectedId = msg?.Id ?? sent?.Id;
    var reading = msg is not null || sent is not null || compose is not null;
    var ready = Model.Settings.IsReady;
    var me = string.IsNullOrEmpty(Model.Settings.FromName) ? "You" : Model.Settings.FromName;
}
<link rel="stylesheet" href="~/css/inbox.css" asp-append-version="true" />

<div class="ol @(reading ? "reading" : "")" data-ol>
    @* ───────── folder pane ───────── *@
    <aside class="ol-folders">
        <a class="ol-new" href="@Url(Model.Folder, compose: "new")">@Html.Raw(I(ic["new"]))<span>New mail</span></a>
        <div class="ol-acct" title="@(ready ? "Sending as " + Model.Settings.FromEmail : "Email is not set up yet")">
            <span class="ol-acct-dot @(ready ? "on" : "")"></span>
            <div><b>@(ready ? (string.IsNullOrEmpty(Model.Settings.FromName) ? Model.Settings.FromEmail : Model.Settings.FromName) : "Email not set up")</b>
                <span>@(ready ? Model.Settings.FromEmail : "Set up to reply & send")</span></div>
        </div>
        <nav class="ol-nav" aria-label="Folders">
            @foreach (var f in PortfolioCms.Controllers.InboxController.Folders)
            {
                var n = Model.Counts.GetValueOrDefault(f);
                <a class="@(Model.Folder == f ? "on" : "")" href="/inbox?folder=@f">
                    @Html.Raw(I(ic[f]))<span>@names[f]</span>
                    @if (n > 0) { <em class="@(f is "inbox" or "unread" ? "strong" : f == "sent" ? "bad" : "")" title="@(f == "sent" ? "Not sent" : "")">@n</em> }
                </a>
            }
        </nav>
        <a class="ol-settings @(ready ? "" : "warn")" href="/inbox/settings">@Html.Raw(I(ic["gear"]))<span>Mail settings</span></a>
    </aside>

    @* ───────── message list ───────── *@
    <section class="ol-list" aria-label="@names[Model.Folder]">
        <div class="ol-list-head">
            <form class="ol-search" method="get" action="/inbox" role="search">
                <input type="hidden" name="folder" value="@Model.Folder" />
                @Html.Raw(I(ic["search"]))
                <input type="search" name="q" value="@Model.Q" placeholder="Search @names[Model.Folder].ToLowerInvariant()" aria-label="Search" data-ol-search />
            </form>
            <div class="ol-list-title">
                <div class="ol-title-main">
                    @if (Model.Items.Count > 0)
                    {
                        <label class="ol-all" title="Select all"><input type="checkbox" data-ol-all aria-label="Select all messages" /></label>
                    }
                    <h1>@names[Model.Folder]</h1>
                </div>
                @if (Model.Folder is "inbox" or "unread" && Model.Counts["inbox"] > 0)
                {
                    <form asp-antiforgery="true" method="post" action="/inbox/markallread" class="inline"><input type="hidden" name="folder" value="@Model.Folder" /><button class="ol-link" title="Mark all as read">@Html.Raw(I(ic["check"])) Mark all read</button></form>
                }
                @if (Model.Folder == "deleted" && Model.Items.Count > 0)
                {
                    <form asp-antiforgery="true" method="post" action="/inbox/emptydeleted" class="inline" data-confirm="Empty Deleted items?" data-name="Empty Deleted items" data-sub="@Model.Items.Count message(s) will be permanently deleted. This can't be undone."><button class="ol-link danger">Empty folder</button></form>
                }
            </div>
            @if (Model.Items.Count > 0)
            {
                var forever = Model.Folder is "deleted" or "sent";
                var isSent = Model.Folder == "sent";
                string? Only(string v) => forever ? v : null; // null → Razor leaves the attribute out
                <form method="post" action="/inbox/bulkdelete" class="ol-bulk" data-ol-bulk hidden
                      data-confirm="@Only(isSent ? "The selected emails and their attachments will be removed from Sent items. This can't be undone." : "The selected messages will be permanently deleted. This can't be undone.")"
                      data-confirm-title="@Only(isSent ? "Remove from Sent items?" : "Delete forever?")"
                      data-confirm-ok="@Only(isSent ? "Delete" : "Delete forever")"
                      data-danger="@Only("")" data-kind="@Only("Selected")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="folder" value="@Model.Folder" />
                    @if (Model.Q is not null) { <input type="hidden" name="q" value="@Model.Q" /> }
                    <b data-ol-count>0 selected</b>
                    <button type="submit" class="ol-link danger" title="@(forever ? "Delete forever" : "Move to Deleted items") (Delete key)">@Html.Raw(I(ic["deleted"]))@(Model.Folder == "deleted" ? "Delete forever" : "Delete")</button>
                    <button type="button" class="ol-link" data-ol-clear title="Clear selection (Esc)">Cancel</button>
                </form>
            }
        </div>
        <div class="ol-items" data-ol-items>
            @if (Model.Items.Count == 0)
            {
                <div class="ol-empty">
                    @Html.Raw(I(ic[Model.Folder]))
                    <b>@(Model.Q is null ? "Nothing here" : "No results")</b>
                    <span>@(Model.Q is not null ? $"Nothing matches “{Model.Q}”." : Model.Folder switch {
                        "inbox" => "Messages from your website's contact form appear here.",
                        "sent" => "Emails you send from the CMS appear here.",
                        "flagged" => "Flag a message to follow up on it later.",
                        "archive" => "Archived messages are kept here.",
                        "deleted" => "Deleted messages stay here until you empty the folder.",
                        _ => "You're all caught up." })</span>
                </div>
            }
            @{ string? lastGroup = null; }
            @foreach (var it in Model.Items)
            {
                var g = Group(it.At);
                if (g != lastGroup) { lastGroup = g; <div class="ol-group">@g</div> }
                <div class="ol-row" data-ol-row>
                <label class="ol-check" title="Select"><input type="checkbox" value="@it.Id" data-ol-check aria-label="Select message from @it.Name" /></label>
                <a class="ol-item @(it.Unread ? "unread" : "") @(it.Id == selectedId ? "sel" : "") @(it.Status == "failed" ? "failed" : "")" href="@Url(id: it.Id)" data-ol-item>
                    <span class="ol-av" style="--av:@(it.Kind == "sent" ? "var(--accent)" : Avatar(it.Email))">@Initials(it.Kind == "sent" ? it.Email : it.Name)</span>
                    <span class="ol-item-main">
                        <span class="ol-row1"><b class="ol-from">@it.Name</b>
                            @if (it.Replied) { <span class="ol-ico" title="Replied">@Html.Raw(I(ic["reply"]))</span> }
                            @if (it.Flagged) { <span class="ol-ico flag" title="Flagged">@Html.Raw(I(ic["flagged"]))</span> }
                            @if (it.HasFiles) { <span class="ol-ico" title="Has attachments">@Html.Raw(I(ic["clip"]))</span> }
                            <time>@When(it.At)</time></span>
                        <span class="ol-subj">@if (it.Status == "failed") { <span class="ol-fail">Not sent</span> }@it.Subject</span>
                        <span class="ol-prev">@it.Preview</span>
                    </span>
                </a>
                </div>
            }
        </div>
    </section>

    @* ───────── reading pane ───────── *@
    <section class="ol-read" aria-label="Reading pane">
        @if (!reading)
        {
            <div class="ol-read-empty">
                @Html.Raw(I(ic["mailopen"]))
                <b>Select an item to read</b>
                <span>Nothing is selected.</span>
            </div>
        }
        else
        {
            <div class="ol-bar">
                <a class="ol-btn ol-back" href="/inbox?folder=@Model.Folder@(Model.Q is null ? "" : "&q=" + Uri.EscapeDataString(Model.Q))" aria-label="Back to list">@Html.Raw(I(ic["back"]))</a>
                @if (msg is not null)
                {
                    <a class="ol-btn primary" href="@Url(id: msg.Id, compose: "reply")">@Html.Raw(I(ic["reply"]))<span>Reply</span></a>
                    <a class="ol-btn" href="@Url(id: msg.Id, compose: "forward")">@Html.Raw(I(ic["forward"]))<span>Forward</span></a>
                    <span class="ol-sep"></span>
                    @if (msg.DeletedAt is null)
                    {
                        <form asp-antiforgery="true" method="post" action="/inbox/markunread/@msg.Id" class="inline"><input type="hidden" name="folder" value="@Model.Folder" /><button class="ol-btn" title="Mark as unread">@Html.Raw(I(ic["unread"]))<span>Unread</span></button></form>
                        <form asp-antiforgery="true" method="post" action="/inbox/flag/@msg.Id" class="inline"><input type="hidden" name="folder" value="@Model.Folder" /><button class="ol-btn @(msg.IsFlagged ? "flagged" : "")" title="@(msg.IsFlagged ? "Clear flag" : "Flag")">@Html.Raw(I(ic["flagged"]))<span>@(msg.IsFlagged ? "Unflag" : "Flag")</span></button></form>
                        <form asp-antiforgery="true" method="post" action="/inbox/archive/@msg.Id" class="inline"><input type="hidden" name="folder" value="@Model.Folder" /><button class="ol-btn" title="@(msg.IsArchived ? "Move to Inbox" : "Archive")">@Html.Raw(I(ic[msg.IsArchived ? "inbox" : "archive"]))<span>@(msg.IsArchived ? "Move to Inbox" : "Archive")</span></button></form>
                        <form asp-antiforgery="true" method="post" action="/inbox/delete/@msg.Id" class="inline"><input type="hidden" name="folder" value="@Model.Folder" /><button class="ol-btn danger" title="Delete">@Html.Raw(I(ic["deleted"]))<span>Delete</span></button></form>
                    }
                    else
                    {
                        <form asp-antiforgery="true" method="post" action="/inbox/restore/@msg.Id" class="inline"><button class="ol-btn">@Html.Raw(I(ic["restore"]))<span>Restore</span></button></form>
                        <form asp-antiforgery="true" method="post" action="/inbox/delete/@msg.Id" class="inline" data-confirm="Delete forever?" data-name="Message from @msg.Name" data-sub="@msg.Email · This can't be undone."><input type="hidden" name="folder" value="deleted" /><button class="ol-btn danger">@Html.Raw(I(ic["deleted"]))<span>Delete forever</span></button></form>
                    }
                }
                else if (sent is not null)
                {
                    <a class="ol-btn primary" href="@Url("sent", compose: "resend", from: sent.Id)">@Html.Raw(I(ic[sent.Status == "failed" ? "restore" : "forward"]))<span>@(sent.Status == "failed" ? "Edit & resend" : "Send again")</span></a>
                    <form asp-antiforgery="true" method="post" action="/inbox/deletesent/@sent.Id" class="inline" data-confirm="Remove from Sent items?" data-name="@sent.Subject" data-sub="To @sent.To"><button class="ol-btn danger">@Html.Raw(I(ic["deleted"]))<span>Delete</span></button></form>
                }
            </div>

            <div class="ol-read-scroll">
                @if (compose is not null)
                {
                    <form asp-antiforgery="true" class="ol-compose" method="post" action="/inbox/send" data-ol-compose>
                        <input type="hidden" name="SubmissionId" value="@compose.SubmissionId" />
                        <input type="hidden" name="Mode" value="@compose.Mode" />
                        <div class="oc-head">
                            <b>@(compose.Mode switch { "reply" => "Reply", "forward" => "Forward", "resend" => "Resend", _ => "New message" })</b>
                            <span class="muted small">From: @(ready ? (string.IsNullOrEmpty(Model.Settings.FromName) ? Model.Settings.FromEmail : $"{Model.Settings.FromName} <{Model.Settings.FromEmail}>") : "not set up")</span>
                        </div>
                        @if (!ready)
                        {
                            <div class="oc-warn">@Html.Raw(I(ic["warn"]))<span>Email isn't set up yet, so this can't be sent. <a href="/inbox/settings">Open Mail settings</a> to connect your email account.</span></div>
                        }
                        <div class="oc-field"><label for="ocTo">To</label><input id="ocTo" type="text" name="To" value="@compose.To" placeholder="name@example.com" required autocomplete="email" />
                            <button type="button" class="ol-link" data-oc-cc-toggle @(string.IsNullOrEmpty(compose.Cc) ? "" : "hidden")>Cc</button></div>
                        <div class="oc-field" data-oc-cc @(string.IsNullOrEmpty(compose.Cc) ? "hidden" : "")><label for="ocCc">Cc</label><input id="ocCc" type="text" name="Cc" value="@compose.Cc" placeholder="Separate several addresses with commas" /></div>
                        <div class="oc-field"><label for="ocSubj">Subject</label><input id="ocSubj" type="text" name="Subject" value="@compose.Subject" maxlength="300" required placeholder="Add a subject" /></div>
                        <div class="oc-files" data-oc-files @(Model.ComposeFiles.Count == 0 ? "hidden" : "")>
                            <div class="oc-files-list" data-oc-list>
                                @foreach (var a in Model.ComposeFiles)
                                {
                                    <div class="oc-file" data-id="@a.Id" data-size="@a.Size">
                                        <span class="oc-ficon @FileKind(a.FileName)">@Ext(a.FileName)</span>
                                        <span class="oc-fname"><b title="@a.FileName">@a.FileName</b><small>@PortfolioCms.Infrastructure.MailFiles.Size(a.Size)</small></span>
                                        <button type="button" class="oc-fx" data-oc-remove aria-label="Remove @a.FileName">×</button>
                                        <input type="hidden" name="AttachmentIds" value="@a.Id" />
                                    </div>
                                }
                            </div>
                            <div class="oc-files-total" data-oc-total></div>
                        </div>
                        <textarea name="Body" class="oc-body" rows="12" required aria-label="Message" data-oc-body>@compose.Body</textarea>
                        <input type="file" multiple hidden accept="@PortfolioCms.Infrastructure.MailFiles.AcceptList" data-oc-file />
                        <div class="oc-drop" data-oc-drop aria-hidden="true"><div>@Html.Raw(I(ic["clip"]))<b>Drop files to attach</b><span>Up to 30 MB in total</span></div></div>
                        <div class="oc-foot">
                            <button type="submit" class="btn primary" @(ready ? "" : "disabled") data-oc-send>@Html.Raw(I(ic["sent"]))Send</button>
                            <button type="button" class="btn" data-oc-attach title="@PortfolioCms.Infrastructure.MailFiles.Friendly · up to 30 MB">@Html.Raw(I(ic["clip"]))Attach</button>
                            <a class="btn" href="@(msg is not null ? Url(id: msg.Id) : sent is not null ? Url("sent", sent.Id) : Url())" data-oc-discard>Discard</a>
                            <span class="muted small hide-mobile oc-hint">JPG, PNG, GIF, Word, Excel, ZIP, RAR, video · up to 30 MB · Ctrl + Enter to send</span>
                        </div>
                    </form>
                }

                @if (msg is not null)
                {
                    <article class="ol-mail">
                        <h2 class="ol-mail-subj">@(string.IsNullOrWhiteSpace(msg.Subject) ? (string.IsNullOrWhiteSpace(msg.InquiryType) ? "Message from your website" : msg.InquiryType) : msg.Subject)
                            @if (msg.IsFlagged) { <span class="ol-ico flag big" title="Flagged">@Html.Raw(I(ic["flagged"]))</span> }</h2>
                        <div class="ol-sender">
                            <span class="ol-av lg" style="--av:@Avatar(msg.Email)">@Initials(msg.Name)</span>
                            <div class="ol-sender-main">
                                <div><b>@msg.Name</b> <a href="mailto:@msg.Email">&lt;@msg.Email&gt;</a></div>
                                <div class="muted small">To: you (website contact form)</div>
                            </div>
                            <time class="muted small">@msg.CreatedAt.ToLocalTime().ToString("ddd d/M/yyyy h:mm tt")</time>
                        </div>
                        @if (!string.IsNullOrEmpty(msg.InquiryType) || !string.IsNullOrEmpty(msg.PageUrl) || msg.RepliedAt is not null)
                        {
                            <div class="ol-tags">
                                @if (msg.RepliedAt is DateTime ra) { <span class="pill ok">You replied @ra.ToLocalTime().ToString("d MMM, h:mm tt")</span> }
                                @if (!string.IsNullOrEmpty(msg.InquiryType)) { <span class="pill accent">@msg.InquiryType</span> }
                                @if (!string.IsNullOrEmpty(msg.PageUrl)) { <span class="pill" title="Sent from this page">@msg.PageUrl</span> }
                            </div>
                        }
                        <div class="ol-body">@msg.Message</div>
                        @if (compose is null)
                        {
                            <div class="ol-quick">
                                <a class="btn" href="@Url(id: msg.Id, compose: "reply")">@Html.Raw(I(ic["reply"]))Reply</a>
                                <a class="btn" href="@Url(id: msg.Id, compose: "forward")">@Html.Raw(I(ic["forward"]))Forward</a>
                            </div>
                        }
                    </article>

                    @if (Model.Thread.Count > 0)
                    {
                        <div class="ol-thread-label">Your replies (@Model.Thread.Count)</div>
                        @foreach (var t in Model.Thread)
                        {
                            <article class="ol-mail mine @(t.Status == "failed" ? "failed" : "")">
                                <div class="ol-sender">
                                    <span class="ol-av" style="--av:var(--accent);--av-text:var(--accent-text)">@Initials(me)</span>
                                    <div class="ol-sender-main">
                                        <div><b>You</b> <span class="muted">to @t.To</span> @if (t.Status == "failed") { <span class="pill off">Not sent</span> }</div>
                                        <div class="muted small">@t.Subject</div>
                                    </div>
                                    <time class="muted small">@t.SentAt.ToLocalTime().ToString("ddd d/M/yyyy h:mm tt")</time>
                                </div>
                                @if (t.Status == "failed") { <div class="oc-warn">@Html.Raw(I(ic["warn"]))<span>@t.Error <a href="@Url("sent", compose: "resend", from: t.Id)">Edit &amp; resend</a></span></div> }
                                <details class="ol-body-fold"><summary>Show message</summary><div class="ol-body">@t.Body</div></details>
                                @if (t.Attachments.Count > 0) { @Html.Raw(FilesHtml(t.Attachments)) }
                            </article>
                        }
                    }
                }
                else if (sent is not null)
                {
                    <article class="ol-mail">
                        <h2 class="ol-mail-subj">@sent.Subject</h2>
                        <div class="ol-sender">
                            <span class="ol-av lg" style="--av:var(--accent);--av-text:var(--accent-text)">@Initials(me)</span>
                            <div class="ol-sender-main">
                                <div><b>You</b> @if (!string.IsNullOrEmpty(Model.Settings.FromEmail)) { <span class="muted">&lt;@Model.Settings.FromEmail&gt;</span> }</div>
                                <div class="muted small">To: @sent.To</div>
                                @if (!string.IsNullOrEmpty(sent.Cc)) { <div class="muted small">Cc: @sent.Cc</div> }
                            </div>
                            <time class="muted small">@sent.SentAt.ToLocalTime().ToString("ddd d/M/yyyy h:mm tt")</time>
                        </div>
                        <div class="ol-tags">
                            @if (sent.Status == "failed") { <span class="pill off">Not sent</span> } else { <span class="pill ok">Sent</span> }
                            @if (sent.Submission is not null) { <a class="pill" href="/inbox?id=@sent.Submission.Id">In reply to @sent.Submission.Name</a> }
                        </div>
                        @if (sent.Status == "failed") { <div class="oc-warn">@Html.Raw(I(ic["warn"]))<span>@sent.Error</span></div> }
                        <div class="ol-body">@sent.Body</div>
                        @if (sent.Attachments.Count > 0) { @Html.Raw(FilesHtml(sent.Attachments)) }
                    </article>
                }
            </div>
        }
    </section>
</div>
<script src="~/js/inbox.js" asp-append-version="true"></script>
