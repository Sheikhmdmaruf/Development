@model List<Submission>
@{ ViewData["Title"] = "Inbox"; }
<div class="head">
    <div><div class="crumb">Messages from your website's contact form</div><h1>Inbox <span class="muted" style="font-weight:400">· @Model.Count(m => !m.IsRead) unread</span></h1></div>
</div>
<div class="panel table-wrap">
    <table class="table">
        <thead><tr><th>From</th><th>Message</th><th class="hide-sm">Service</th><th>Received</th></tr></thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr class="@(s.IsRead ? "" : "unread")">
                <td><a class="title" href="/inbox/open/@s.Id">@s.Name</a><div class="sub">@s.Email</div></td>
                <td><div class="sub" style="max-width:480px">@s.Message</div></td>
                <td class="hide-sm">@s.InquiryType</td>
                <td class="muted" style="white-space:nowrap">@s.CreatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</td>
            </tr>
        }
        </tbody>
    </table>
    @if (Model.Count == 0) { <div class="empty">No messages yet. When someone sends the contact form on your website, it appears here.</div> }
</div>
