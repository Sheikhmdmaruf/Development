@model Submission
@{
    ViewData["Title"] = "Message from " + Model.Name;
    var reply = $"mailto:{Model.Email}?subject={Uri.EscapeDataString("Re: " + (Model.Subject ?? "your message"))}";
}
<div class="head">
    <div><div class="crumb"><a href="/inbox">Inbox</a> /</div><h1>@Model.Name</h1></div>
    <div class="actions">
        <a class="btn primary" href="@reply">Reply by email</a>
        <form asp-antiforgery="true" class="inline" method="post" action="/inbox/markunread/@Model.Id"><button class="btn">Mark unread</button></form>
        <form asp-antiforgery="true" class="inline" method="post" action="/inbox/delete/@Model.Id" data-confirm="Delete this message?"><button class="btn danger">Delete</button></form>
    </div>
</div>
<div class="panel"><div class="panel-body">
    <dl class="kv">
        <dt>Email</dt><dd><a href="mailto:@Model.Email">@Model.Email</a></dd>
        @if (!string.IsNullOrEmpty(Model.InquiryType)) { <dt>Service</dt><dd>@Model.InquiryType</dd> }
        <dt>Received</dt><dd>@Model.CreatedAt.ToLocalTime().ToString("dddd, d MMMM yyyy 'at' HH:mm")</dd>
        @if (!string.IsNullOrEmpty(Model.PageUrl)) { <dt>Sent from</dt><dd class="muted">@Model.PageUrl</dd> }
    </dl>
</div></div>
<div class="panel"><div class="panel-body msg-body">@Model.Message</div></div>
