@{
    ViewData["Title"] = "My workspace";
    var assigned = (List<Contact>)ViewBag.Assigned;
    var notes = (List<Notification>)ViewBag.Notifications;
    var activity = (List<ActivityLog>)ViewBag.Activity;
}
<div class="page-head">
    <div><span class="eyebrow">My workspace</span><h1>Your work, in one place</h1><p>Contacts assigned to you, your notifications and recent actions.</p></div>
</div>
<div class="grid cols-3">
    <div class="card span-2">
        <div class="card-head"><div><h2>Assigned to me</h2><p>@assigned.Count contacts</p></div></div>
        <div class="list">
            @if (assigned.Count == 0)
            {
                <div class="empty"><div class="empty-icon"><i data-lucide="inbox"></i></div><h3>Nothing assigned to you</h3><p>When someone assigns a contact to you, it shows up here.</p></div>
            }
            @foreach (var c in assigned)
            {
                <a class="list-item" href="/contacts/@c.Id">
                    <span class="avatar sm" style="@Ui.AvatarStyle(c.Email)">@Ui.Initials(c.Name)</span>
                    <div class="grow"><div class="truncate" style="font-weight:600">@c.Name</div><div class="small faint truncate">@c.InquiryType · @(c.FirstWebsite?.Name ?? c.Source) · @Time.Ago(c.LastActivityAt)</div></div>
                    <span class="badge status-@c.Status">@c.Status.Label()</span>
                </a>
            }
        </div>
    </div>
    <div class="stack">
        <div class="card">
            <div class="card-head"><h2>Notifications</h2><a class="btn btn-text btn-sm" href="/notifications">All</a></div>
            <div style="padding-bottom:8px"><partial name="_NotificationItems" model="notes" /></div>
        </div>
        <div class="card">
            <div class="card-head"><h2>My recent actions</h2></div>
            <div class="feed" style="padding-bottom:8px">
                @if (activity.Count == 0) { <div class="empty small"><p>No actions yet.</p></div> }
                @foreach (var a in activity)
                {
                    var (icon, tone) = ActivityService.Visual(a.Action);
                    <div class="feed-item"><span class="fi-icon tone-@tone"><i data-lucide="@icon"></i></span><div class="grow"><div class="fi-text">@a.Summary</div><div class="fi-meta">@Time.Ago(a.CreatedAt)</div></div></div>
                }
            </div>
        </div>
    </div>
</div>
