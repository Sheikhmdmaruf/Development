@model ContactListModel
@{
    ViewData["Title"] = "Contacts";
    var f = Model.Filter;
    var canEdit = User.Has(Permissions.Contacts.Edit);
    var canAssign = User.Has(Permissions.Contacts.Assign);
    var canDelete = User.Has(Permissions.Contacts.Delete);
    var current = Context.Request.Path + Context.Request.QueryString;
    var exportQuery = Context.Request.QueryString.Value;
}
<div class="page-head">
    <div><span class="eyebrow">CRM</span><h1>Contacts</h1><p>Every inquiry from every connected website, in one list.</p></div>
    <div class="page-actions">
        @if (User.Has(Permissions.Contacts.Export)) { <a class="btn btn-ghost" href="/contacts/export@(exportQuery)"><i data-lucide="download"></i>Export CSV</a> }
        @if (User.Has(Permissions.Contacts.Create)) { <a class="btn btn-primary" href="/contacts/new"><i data-lucide="user-plus"></i>Add contact</a> }
    </div>
</div>

<div class="card">
    <div class="tabs" style="padding:0 12px">
        <a href="/contacts" class="@(!f.Archived ? "active" : null)">Active <span class="count">@Model.ActiveCount</span></a>
        <a href="/contacts?archived=true" class="@(f.Archived ? "active" : null)">Archived <span class="count">@Model.ArchivedCount</span></a>
    </div>

    <form method="get" action="/contacts" class="filters" role="search">
        @if (f.Archived) { <input type="hidden" name="archived" value="true"> }
        <div class="input-group"><i data-lucide="search"></i><input class="input input-sm" name="q" value="@f.Q" placeholder="Search name, email, company or message…" aria-label="Search contacts"></div>
        <select class="select input-sm" name="status" data-autosubmit aria-label="Status">
            <option value="">All statuses</option>
            @foreach (var s in Ui.Statuses) { <option value="@s" selected="@(f.Status == s)">@s.Label()</option> }
        </select>
        <select class="select input-sm" name="website" data-autosubmit aria-label="Website">
            <option value="">All websites</option>
            @foreach (var w in Model.Websites) { <option value="@w.Id" selected="@(f.Website == w.Id)">@w.Name</option> }
        </select>
        <select class="select input-sm" name="type" data-autosubmit aria-label="Inquiry type">
            <option value="">All types</option>
            @foreach (var t in Model.Types) { <option selected="@(f.Type == t)">@t</option> }
        </select>
        <select class="select input-sm" name="assigned" data-autosubmit aria-label="Assigned to">
            <option value="">Anyone</option>
            <option value="me" selected="@(f.Assigned == "me")">Assigned to me</option>
            <option value="none" selected="@(f.Assigned == "none")">Unassigned</option>
            @foreach (var u in Model.Members) { <option value="@u.Id" selected="@(f.Assigned == u.Id)">@u.FullName</option> }
        </select>
        @if (Model.Tags.Count > 0)
        {
            <select class="select input-sm" name="tag" data-autosubmit aria-label="Tag">
                <option value="">Any tag</option>
                @foreach (var t in Model.Tags) { <option value="@t.Id" selected="@(f.Tag == t.Id)">@t.Name</option> }
            </select>
        }
        <select class="select input-sm" name="sort" data-autosubmit aria-label="Sort">
            <option value="">Recent activity</option>
            <option value="newest" selected="@(f.Sort == "newest")">Newest first</option>
            <option value="oldest" selected="@(f.Sort == "oldest")">Oldest first</option>
            <option value="name" selected="@(f.Sort == "name")">Name A–Z</option>
        </select>
        <label class="check small"><input type="checkbox" name="unread" value="true" checked="@f.Unread" data-autosubmit> Unread only</label>
        <button class="btn btn-ghost btn-sm" type="submit">Apply</button>
        @if (f.Any) { <a class="btn btn-text btn-sm" href="/contacts@(f.Archived ? "?archived=true" : "")"><i data-lucide="x"></i>Clear</a> }
    </form>

    <form method="post" action="/contacts/bulk" id="bulk-form">
        <input type="hidden" name="returnUrl" value="@current">
        <div class="bulkbar" data-bulkbar hidden>
            <b><span data-bulk-count>0</span> selected</b>
            <span class="grow"></span>
            <button class="btn btn-ghost btn-sm" name="action" value="read">Mark read</button>
            <button class="btn btn-ghost btn-sm" name="action" value="unread">Mark unread</button>
            @if (canEdit)
            {
                <select class="select input-sm" name="status" style="width:auto" aria-label="New status">@foreach (var s in Ui.Statuses) { <option value="@s">@s.Label()</option> }</select>
                <button class="btn btn-ghost btn-sm" name="action" value="status">Set status</button>
            }
            @if (canAssign)
            {
                <select class="select input-sm" name="userId" style="width:auto" aria-label="Assign to"><option value="">Nobody</option>@foreach (var u in Model.Members) { <option value="@u.Id">@u.FullName</option> }</select>
                <button class="btn btn-ghost btn-sm" name="action" value="assign">Assign</button>
            }
            @if (canDelete)
            {
                if (f.Archived)
                {
                    <button class="btn btn-ghost btn-sm" name="action" value="restore">Restore</button>
                    <button class="btn btn-danger btn-sm" name="action" value="delete" data-confirm="Permanently delete the selected contacts and all their messages? This can't be undone." data-confirm-label="Delete forever">Delete</button>
                }
                else { <button class="btn btn-danger btn-sm" name="action" value="archive">Archive</button> }
            }
        </div>

        @if (Model.Result.Items.Count == 0)
        {
            <div class="empty">
                <div class="empty-icon"><i data-lucide="@(f.Any ? "search-x" : "inbox")"></i></div>
                @if (f.Any) { <h3>No contacts match these filters</h3><p>Try removing a filter or searching for something else.</p> }
                else if (f.Archived) { <h3>No archived contacts</h3><p>Contacts you archive appear here and can be restored.</p> }
                else
                {
                    <h3>No inquiries yet</h3>
                    <p>Connect your websites to collect contact form submissions here automatically.</p>
                    <div class="row">@if (User.Has(Permissions.Websites.View)) { <a class="btn btn-primary btn-sm" href="/websites">Connect a website</a> }@if (User.Has(Permissions.Contacts.Create)) { <a class="btn btn-ghost btn-sm" href="/contacts/new">Add manually</a> }</div>
                }
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th class="w-check"><input type="checkbox" class="check" data-check-all aria-label="Select all"></th>
                            <th>Contact</th><th class="hide-sm">Inquiry</th><th>Status</th><th class="hide-sm">Website</th><th class="hide-sm">Assigned</th><th class="hide-sm">Last activity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Result.Items)
                        {
                            <tr class="@(c.IsUnread ? "unread" : null)">
                                <td class="w-check"><input type="checkbox" name="ids" value="@c.Id" data-check-item aria-label="Select @c.Name"></td>
                                <td>
                                    <a class="cell-user row-link" href="/contacts/@c.Id">
                                        <span class="avatar sm" style="@Ui.AvatarStyle(c.Email)">@Ui.Initials(c.Name)</span>
                                        <span style="min-width:0"><span class="name truncate">@c.Name</span><span class="sub truncate">@c.Email</span></span>
                                    </a>
                                </td>
                                <td class="hide-sm">
                                    <div class="truncate" style="max-width:220px">@(c.InquiryType ?? "—")</div>
                                    @if (c.Tags.Count > 0) { <div class="tags" style="margin-top:4px">@foreach (var t in c.Tags.Take(3)) { <span class="tag tone-@t.Tag.Color">@t.Tag.Name</span> }</div> }
                                </td>
                                <td><span class="badge status-@c.Status">@c.Status.Label()</span></td>
                                <td class="hide-sm small muted">@(c.FirstWebsite?.Name ?? c.Source ?? "—")</td>
                                <td class="hide-sm">
                                    @if (c.AssignedTo is { } a) { <span class="row" style="gap:6px"><span class="avatar sm" style="@Ui.AvatarStyle(a.FullName)">@a.Initials</span><span class="small">@a.FullName</span></span> }
                                    else { <span class="small faint">Unassigned</span> }
                                </td>
                                <td class="hide-sm small muted nowrap" title="@c.LastActivityAt.ToLocalTime().ToString("f")">@Time.Ago(c.LastActivityAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </form>
    <partial name="_Pager" model="@(new PagerModel(Model.Result.Page, Model.Result.Pages, Model.Result.From, Model.Result.To, Model.Result.Total))" />
</div>
