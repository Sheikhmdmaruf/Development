@model MemberForm
@{
    var isNew = Model.Id is null;
    ViewData["Title"] = isNew ? "Add member" : "Edit " + Model.FullName;
    var roles = (List<AppRole>)ViewBag.Roles;
}
<div class="crumbs"><a href="/team">Team</a><i data-lucide="chevron-right" class="sm"></i><span>@(isNew ? "New" : Model.FullName)</span></div>
<div class="page-head"><div><h1>@(isNew ? "Add a team member" : "Edit member")</h1><p>@(isNew ? "They get a temporary password and must set their own at first sign-in." : "Changes to role and status apply to their sessions within a minute.")</p></div></div>
<form method="post" action="@(isNew ? "/team/new" : $"/team/{Model.Id}/edit")" class="card" style="max-width:860px">
    <div class="card-body stack">
        <div asp-validation-summary="ModelOnly"></div>
        <div class="form-grid">
            <div class="field"><label asp-for="FullName"></label><input asp-for="FullName" class="input" autofocus><span asp-validation-for="FullName"></span></div>
            <div class="field"><label asp-for="Email">Email (used to sign in)</label><input asp-for="Email" class="input"><span asp-validation-for="Email"></span></div>
            <div class="field"><label asp-for="JobTitle"></label><input asp-for="JobTitle" class="input" placeholder="UI Designer"></div>
            <div class="field">
                <label asp-for="Role"></label>
                <select asp-for="Role" class="select">@foreach (var r in roles) { <option value="@r.Name">@r.Name</option> }</select>
                <span asp-validation-for="Role"></span>
            </div>
            <div class="full stack-sm">
                @foreach (var r in roles) { <div class="small muted"><b>@r.Name:</b> @r.Description</div> }
            </div>
            @if (!isNew) { <label class="switch full"><input type="checkbox" asp-for="IsActive"><span><b>Active</b><br><span class="small muted">Deactivated members can't sign in and their contacts become unassigned.</span></span></label><span asp-validation-for="IsActive"></span> }
        </div>
        <div class="form-actions"><a class="btn btn-ghost" href="@(isNew ? "/team" : $"/team/{Model.Id}")">Cancel</a><button class="btn btn-primary">@(isNew ? "Add member" : "Save changes")</button></div>
    </div>
</form>
