@model AppUser
@{
    ViewData["Title"] = Model.FullName;
    var roles = (IList<string>)ViewBag.Roles;
    var contacts = (List<Contact>)ViewBag.Contacts;
    var activity = (List<ActivityLog>)ViewBag.Activity;
    string? newPassword = ViewBag.NewPassword;
    var manage = User.Has(Permissions.Team.Manage) && (User.IsSuperAdmin() || !roles.Contains(Permissions.SuperAdminRole));
    var isMe = Model.Id == User.Id();
    dynamic stats = ViewBag.ContactStats;
    var statDict = (Dictionary<LeadStatus, int>)stats;
    var totalAssigned = statDict.Values.Sum();
}
<div class="crumbs"><a href="/team">Team</a><i data-lucide="chevron-right" class="sm"></i><span>@Model.FullName</span></div>
<div class="page-head">
    <div class="row" style="gap:16px">
        <span class="avatar xl" style="@Ui.AvatarStyle(Model.FullName)">@if (Model.AvatarPath is not null) { <img src="@Model.AvatarPath" alt=""> } else { @Model.Initials }</span>
        <div>
            <h1>@Model.FullName</h1>
            <div class="row wrap" style="margin-top:6px;gap:8px">
                @foreach (var r in roles) { <span class="tag tone-blue">@r</span> }
                @if (!Model.IsActive) { <span class="badge tone-slate">Deactivated</span> }
                <span class="small muted">@Model.JobTitle</span>
            </div>
        </div>
    </div>
    @if (manage)
    {
        <div class="page-actions">
            <a class="btn btn-ghost" href="/team/@Model.Id/edit"><i data-lucide="pencil"></i>Edit</a>
            @if (!isMe)
            {
                <form method="post" action="/team/@Model.Id/reset-password" data-confirm="Create a new temporary password for @Model.FullName? Their current password stops working." data-confirm-label="Reset password"><button class="btn btn-ghost"><i data-lucide="key-round"></i>Reset password</button></form>
                <form method="post" action="/team/@Model.Id/delete" data-confirm="Remove @Model.FullName from the team? Their contacts become unassigned. Their notes and history stay." data-confirm-label="Remove"><button class="btn btn-danger btn-icon" aria-label="Remove member"><i data-lucide="user-round-x"></i></button></form>
            }
        </div>
    }
</div>

@if (newPassword is not null)
{
    <div class="card pad stack-sm" style="border-color:var(--warning);margin-bottom:16px">
        <div class="row"><i data-lucide="key-round" style="color:var(--warning)"></i><b>Temporary password — share it privately</b></div>
        <p class="small muted">@Model.FullName signs in at this dashboard with <b>@Model.Email</b> and this password, then must choose their own. It won't be shown again.</p>
        <div class="keybox"><code id="pw">@newPassword</code><button type="button" class="btn btn-soft btn-sm" data-copy-from="#pw"><i data-lucide="copy"></i>Copy</button></div>
    </div>
}

<div class="grid cols-4">
    <div class="card stat"><span class="eyebrow">Assigned contacts</span><div class="stat-value">@totalAssigned</div><div class="stat-foot">all time</div></div>
    <div class="card stat"><span class="eyebrow">Converted</span><div class="stat-value">@statDict.GetValueOrDefault(LeadStatus.Converted)</div><div class="stat-foot">@(totalAssigned == 0 ? "—" : $"{statDict.GetValueOrDefault(LeadStatus.Converted) * 100 / totalAssigned}% conversion")</div></div>
    <div class="card stat"><span class="eyebrow">Last sign-in</span><div class="stat-value" style="font-size:22px">@(Model.LastLoginAt is { } d ? Time.Ago(d) : "Never")</div><div class="stat-foot">Member since @Model.CreatedAt.ToString("MMM yyyy")</div></div>
    <div class="card stat"><span class="eyebrow">Tasks</span><div class="stat-value faint">—</div><div class="stat-foot">Task stats arrive with phase 2</div></div>
</div>

<div class="grid cols-2 mt">
    <div class="card">
        <div class="card-head"><h2>Assigned contacts</h2><a class="btn btn-text btn-sm" href="/contacts?assigned=@Model.Id">All</a></div>
        <div class="list">
            @if (contacts.Count == 0) { <div class="empty small"><p>No open contacts assigned.</p></div> }
            @foreach (var c in contacts)
            {
                <a class="list-item" href="/contacts/@c.Id"><span class="avatar sm" style="@Ui.AvatarStyle(c.Email)">@Ui.Initials(c.Name)</span><div class="grow truncate">@c.Name</div><span class="badge status-@c.Status">@c.Status.Label()</span></a>
            }
        </div>
    </div>
    <div class="card">
        <div class="card-head"><h2>Recent activity</h2></div>
        <div class="feed" style="padding-bottom:8px">
            @if (!User.Has(Permissions.Team.ViewActivity)) { <div class="empty small"><p>Your role can't view team activity.</p></div> }
            else if (activity.Count == 0) { <div class="empty small"><p>No activity yet.</p></div> }
            @foreach (var a in activity)
            {
                var (icon, tone) = ActivityService.Visual(a.Action);
                <div class="feed-item"><span class="fi-icon tone-@tone"><i data-lucide="@icon"></i></span><div class="grow"><div class="fi-text">@a.Summary</div><div class="fi-meta">@Time.Ago(a.CreatedAt)</div></div></div>
            }
        </div>
    </div>
</div>
