@model List<MemberRow>
@{ ViewData["Title"] = "Team"; string? q = ViewBag.Q; bool inactive = ViewBag.Inactive; int inactiveCount = ViewBag.InactiveCount; }
<div class="page-head">
    <div><span class="eyebrow">Team</span><h1>Team members</h1><p>Who can sign in, and what they can do.</p></div>
    <div class="page-actions">
        @if (User.Has(Permissions.Settings.Roles)) { <a class="btn btn-ghost" href="/settings/roles"><i data-lucide="shield-check"></i>Roles &amp; permissions</a> }
        @if (User.Has(Permissions.Team.Manage)) { <a class="btn btn-primary" href="/team/new"><i data-lucide="user-round-plus"></i>Add member</a> }
    </div>
</div>
<div class="card">
    <div class="tabs" style="padding:0 12px">
        <a href="/team" class="@(!inactive ? "active" : null)">Active</a>
        <a href="/team?inactive=true" class="@(inactive ? "active" : null)">Deactivated <span class="count">@inactiveCount</span></a>
    </div>
    <form class="filters" method="get" action="/team">
        @if (inactive) { <input type="hidden" name="inactive" value="true"> }
        <div class="input-group"><i data-lucide="search"></i><input class="input input-sm" name="q" value="@q" placeholder="Search name, email or title…" aria-label="Search team"></div>
        <button class="btn btn-ghost btn-sm">Search</button>
    </form>
    @if (Model.Count == 0) { <div class="empty"><div class="empty-icon"><i data-lucide="users"></i></div><h3>No members found</h3></div> }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Member</th><th>Role</th><th class="hide-sm">Assigned contacts</th><th class="hide-sm">Last sign-in</th></tr></thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td><a class="cell-user row-link" href="/team/@m.User.Id">
                            <span class="avatar" style="@Ui.AvatarStyle(m.User.FullName)">@if (m.User.AvatarPath is not null) { <img src="@m.User.AvatarPath" alt=""> } else { @m.User.Initials }</span>
                            <span><span class="name">@m.User.FullName @if (m.User.Id == User.Id()) { <span class="tag tone-slate">You</span> }</span><span class="sub">@m.User.Email@(m.User.JobTitle is null ? "" : " · " + m.User.JobTitle)</span></span>
                        </a></td>
                        <td><span class="tag @(m.Role == Permissions.SuperAdminRole ? "tone-coral" : m.Role == "Admin" ? "tone-violet" : "tone-blue")">@(string.IsNullOrEmpty(m.Role) ? "No role" : m.Role)</span></td>
                        <td class="hide-sm">@m.AssignedContacts</td>
                        <td class="hide-sm small muted">@(m.User.LastLoginAt is { } d ? Time.Ago(d) : "Never")</td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
</div>
