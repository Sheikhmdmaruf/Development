@model Paged<ActivityLog>
@{
    ViewData["Title"] = "Team activity";
    var members = (List<AppUser>)ViewBag.Members;
    string? user = ViewBag.User; string? type = ViewBag.Type;
    var types = new[] { ("contact", "Contacts"), ("submission", "Inquiries"), ("content", "Content"), ("website", "Websites"), ("team", "Team"), ("media", "Uploads") };
}
<div class="page-head"><div><span class="eyebrow">Team</span><h1>Team activity</h1><p>Everything your team did, newest first.</p></div></div>
<div class="card">
    <form class="filters" method="get" action="/team/activity">
        <select class="select input-sm" name="user" data-autosubmit aria-label="Member"><option value="">Everyone</option>@foreach (var m in members) { <option value="@m.Id" selected="@(m.Id == user)">@m.FullName</option> }</select>
        <select class="select input-sm" name="type" data-autosubmit aria-label="Type"><option value="">All types</option>@foreach (var (k, l) in types) { <option value="@k" selected="@(k == type)">@l</option> }</select>
        @if (user is not null || type is not null) { <a class="btn btn-text btn-sm" href="/team/activity"><i data-lucide="x"></i>Clear</a> }
    </form>
    <div class="feed" style="padding:8px 0">
        @if (Model.Items.Count == 0) { <div class="empty"><div class="empty-icon"><i data-lucide="activity"></i></div><h3>No activity</h3></div> }
        @foreach (var a in Model.Items)
        {
            var (icon, tone) = ActivityService.Visual(a.Action);
            <div class="feed-item">
                <span class="fi-icon tone-@tone"><i data-lucide="@icon"></i></span>
                <div class="grow">
                    <div class="fi-text"><b>@(a.User?.FullName ?? "System")</b> <span class="muted">·</span> @a.Summary</div>
                    <div class="fi-meta" title="@a.CreatedAt.ToLocalTime().ToString("f")">@a.CreatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm") · @Time.Ago(a.CreatedAt)
                        @if (a.EntityType == "Contact" && a.EntityId is not null && User.Has(Permissions.Contacts.View)) { <span> · <a href="/contacts/@a.EntityId">Open contact</a></span> }
                    </div>
                </div>
            </div>
        }
    </div>
    <partial name="_Pager" model="@(new PagerModel(Model.Page, Model.Pages, Model.From, Model.To, Model.Total))" />
</div>
