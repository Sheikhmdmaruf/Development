@{
    Layout = ViewData["Layout"] as string;
    int code = ViewBag.Code;
    ViewData["Title"] = code == 404 ? "Not found" : "Error";
    var (icon, title, text) = code switch
    {
        404 => ("map-pin-off", "Page not found", "The page you're looking for doesn't exist or was moved."),
        403 => ("shield-alert", "No access", "Your role doesn't allow this action."),
        429 => ("timer", "Too many requests", "Please wait a minute and try again."),
        _ => ("triangle-alert", "Something went wrong", "The error was logged. Please try again."),
    };
}
<div class="card">
    <div class="empty">
        <div class="empty-icon tone-coral"><i data-lucide="@icon"></i></div>
        <span class="eyebrow">Error @code</span>
        <h3>@title</h3>
        <p>@text</p>
        <a class="btn btn-ghost" href="/"><i data-lucide="arrow-left"></i>Back to overview</a>
    </div>
</div>
