@model List<Website>
@{ ViewData["Title"] = "Integrations"; string apiBase = ViewBag.ApiBase; }
<div class="page-head">
    <div><span class="eyebrow">System</span><h1>Integrations</h1><p>What's connected to your dashboard, and what's coming next.</p></div>
</div>

<div class="grid cols-2">
    <div class="card">
        <div class="card-head"><div class="row"><span class="stat-icon tone-teal"><i data-lucide="globe"></i></span><div><h2>Website contact forms</h2><p>Live · @Model.Count(w => w.IsActive) of @Model.Count websites active</p></div></div><a class="btn btn-ghost btn-sm" href="/websites">Manage</a></div>
        <div class="list" style="margin-top:12px">
            @if (Model.Count == 0) { <div class="empty small"><p>No websites connected yet.</p></div> }
            @foreach (var w in Model)
            {
                <a class="list-item" href="/websites/@w.Id">
                    <span class="dot-status @(!w.IsActive ? "off" : w.LastSubmissionAt is null ? "warn" : "on")"></span>
                    <div class="grow"><b>@w.Name</b><div class="small faint">@(w.LastSubmissionAt is { } d ? "Last submission " + Time.Ago(d) : "No submissions yet")</div></div>
                    @if (w.CanReadContent) { <span class="tag tone-violet">CMS</span> }
                    <i data-lucide="chevron-right" class="sm faint"></i>
                </a>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-head"><div class="row"><span class="stat-icon tone-blue"><i data-lucide="code-xml"></i></span><div><h2>Public API</h2><p>Endpoints your websites call</p></div></div></div>
        <div class="card-body">
            <div class="table-wrap"><table class="table">
                <thead><tr><th>Endpoint</th><th>Auth</th><th>Limit</th></tr></thead>
                <tbody>
                    <tr><td><code>POST /api/v1/submissions</code><div class="small faint">Contact form submission</div></td><td class="small">Site key + allowed origin, or secret key</td><td class="small nowrap">5 / min / IP</td></tr>
                    <tr><td><code>GET /api/v1/content</code><div class="small faint">Published portfolio content</div></td><td class="small">Site key with "Can read content"</td><td class="small nowrap">120 / min / IP</td></tr>
                    <tr><td><code>GET /api/v1/health</code><div class="small faint">Check the key works</div></td><td class="small">Site key</td><td class="small nowrap">120 / min / IP</td></tr>
                </tbody>
            </table></div>
            <p class="small faint" style="margin-top:12px">Base URL: <code>@apiBase</code>. Set <code>App:PublicBaseUrl</code> in production so image links use your public domain.</p>
        </div>
    </div>

    <div class="card">
        <div class="card-head"><div class="row"><span class="stat-icon tone-coral"><i data-lucide="mail"></i></span><div><h2>Email accounts</h2><p>Gmail (OAuth), IMAP/SMTP, Resend / SendGrid</p></div></div><span class="badge tone-slate">Not connected</span></div>
        <div class="card-body"><p class="small muted">The email inbox is built in phase 3. No email account is connected yet, and nothing here pretends otherwise.</p></div>
    </div>

    <div class="card">
        <div class="card-head"><div class="row"><span class="stat-icon tone-violet"><i data-lucide="webhook"></i></span><div><h2>Outgoing webhooks</h2><p>Notify other tools when things happen</p></div></div><span class="badge tone-slate">Not set up</span></div>
        <div class="card-body"><p class="small muted">Planned with the reports &amp; settings phase.</p></div>
    </div>
</div>
