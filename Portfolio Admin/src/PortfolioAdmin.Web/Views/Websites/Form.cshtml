@model PortfolioAdmin.Web.Controllers.WebsiteForm
@{
    var isNew = Model.Id is null;
    ViewData["Title"] = isNew ? "Connect website" : "Edit " + Model.Name;
}
<div class="crumbs"><a href="/websites">Websites</a><i data-lucide="chevron-right" class="sm"></i><span>@(isNew ? "New" : Model.Name)</span></div>
<div class="page-head"><div><h1>@(isNew ? "Connect a website" : "Edit website")</h1><p>Keys are created automatically when you save.</p></div></div>

<form method="post" action="@(isNew ? "/websites/new" : $"/websites/{Model.Id}/edit")" class="card" style="max-width:860px">
    <div class="card-body stack">
        <div asp-validation-summary="ModelOnly"></div>
        <div class="form-grid">
            <div class="field"><label asp-for="Name"></label><input asp-for="Name" class="input" id="site-name" placeholder="My Portfolio" autofocus><span asp-validation-for="Name"></span></div>
            <div class="field"><label asp-for="Url"></label><input asp-for="Url" class="input" placeholder="https://maruf.design"><span asp-validation-for="Url"></span></div>
            <div class="field">
                <label asp-for="Identifier"></label>
                <input asp-for="Identifier" class="input mono" data-slug-from="#site-name" placeholder="portfolio">
                <span class="hint">Short unique name used in reports, e.g. <code>portfolio</code>.</span>
                <span asp-validation-for="Identifier"></span>
            </div>
            <div class="field full">
                <label asp-for="AllowedOrigins"></label>
                <textarea asp-for="AllowedOrigins" class="textarea mono" rows="3" placeholder="https://www.maruf.design&#10;http://localhost:5173"></textarea>
                <span class="hint">Browsers may only use the site key from these addresses (one per line). The website URL above is always allowed. Add <code>http://localhost:5173</code> while developing.</span>
                <span asp-validation-for="AllowedOrigins"></span>
            </div>
            <label class="switch full"><input type="checkbox" asp-for="CanReadContent"><span><b>Can read portfolio content</b><br><span class="small muted">Turn on for the portfolio site so it can load projects, services, posts and settings from this dashboard.</span></span></label>
            <label class="switch full"><input type="checkbox" asp-for="IsActive"><span><b>Active</b><br><span class="small muted">When off, all requests with this website's keys are rejected.</span></span></label>
        </div>
        <div class="form-actions">
            <a class="btn btn-ghost" href="@(isNew ? "/websites" : $"/websites/{Model.Id}")">Cancel</a>
            <button class="btn btn-primary">@(isNew ? "Connect website" : "Save changes")</button>
        </div>
    </div>
</form>
