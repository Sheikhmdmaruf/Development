@model LoginModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Sign in"; }
<h1>Welcome back</h1>
<p class="muted" style="margin:6px 0 22px">Sign in to manage inquiries, content and your team.</p>
<form method="post" action="/login" class="stack">
    <div asp-validation-summary="ModelOnly"></div>
    <input type="hidden" asp-for="ReturnUrl">
    <div class="field">
        <label asp-for="Email">Email</label>
        <div class="input-group"><i data-lucide="mail"></i><input asp-for="Email" class="input" autocomplete="username" autofocus></div>
        <span asp-validation-for="Email"></span>
    </div>
    <div class="field">
        <label asp-for="Password">Password</label>
        <div class="input-group"><i data-lucide="lock"></i><input asp-for="Password" class="input" autocomplete="current-password"></div>
        <span asp-validation-for="Password"></span>
    </div>
    <label class="check"><input asp-for="RememberMe"> Keep me signed in</label>
    <button class="btn btn-primary" type="submit" style="height:42px">Sign in <i data-lucide="arrow-right"></i></button>
    <p class="small faint" style="text-align:center">Accounts are created by an admin. Ask your admin if you forgot your password.</p>
</form>
