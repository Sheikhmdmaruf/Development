@model ChangePasswordModel
@{ ViewData["Title"] = "Change password"; }
<partial name="_SettingsHead" model="@("password")" />
@if (Model.Required)
{
    <div class="callout tone-amber" style="margin-bottom:16px"><i data-lucide="shield-alert"></i><div>You're using a temporary password. Please set your own password to continue.</div></div>
}
<form method="post" action="/account/password" class="card" style="max-width:560px">
    <input type="hidden" asp-for="Required">
    <div class="card-head"><div><h2>Change password</h2><p>At least 10 characters with upper and lower case letters and a number.</p></div></div>
    <div class="card-body stack">
        <div asp-validation-summary="ModelOnly"></div>
        <div class="field"><label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword" class="input" autocomplete="current-password"><span asp-validation-for="CurrentPassword"></span></div>
        <div class="field"><label asp-for="NewPassword"></label><input asp-for="NewPassword" class="input" autocomplete="new-password"><span asp-validation-for="NewPassword"></span></div>
        <div class="field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="input" autocomplete="new-password"><span asp-validation-for="ConfirmPassword"></span></div>
        <div class="form-actions"><button class="btn btn-primary">Update password</button></div>
    </div>
</form>
