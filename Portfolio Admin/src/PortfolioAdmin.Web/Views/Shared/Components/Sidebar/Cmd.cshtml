@model List<PortfolioAdmin.Web.ViewComponents.NavGroup>
@{
    var contacts = Model.SelectMany(g => g.Items).FirstOrDefault(i => i.Href == "/contacts");
    var canCreate = User.HasAny(Permissions.Contacts.Create, Permissions.Content.Edit, Permissions.Websites.Manage, Permissions.Team.Manage);
}
@* Floating command bar at the bottom of the screen (desktop). *@
<div class="cmdbar" role="toolbar" aria-label="Quick actions">
    <button type="button" class="cmd-search" data-palette-open><i data-lucide="search" class="sm"></i><span>Search or jump to…</span><kbd>Ctrl K</kbd></button>
    <span class="sep"></span>
    @if (contacts is not null)
    {
        <a class="cmd-btn" href="/contacts?unread=true" title="Unread inquiries"><i data-lucide="inbox" class="sm"></i>Inbox @if (contacts.Count is int n) { <span class="n">@(n > 99 ? "99+" : n)</span> }</a>
        <a class="cmd-btn" href="/leads" title="Leads board"><i data-lucide="kanban" class="sm"></i>Leads</a>
    }
    @if (canCreate)
    {
        <div class="dropdown">
            <button type="button" class="cmd-btn primary" data-dropdown-toggle aria-haspopup="menu" aria-expanded="false"><i data-lucide="circle-plus" class="sm"></i>Create</button>
            <div class="menu up" role="menu">
                @if (User.Has(Permissions.Contacts.Create)) { <a href="/contacts/new"><i data-lucide="user-plus"></i>Contact</a> }
                @if (User.Has(Permissions.Content.Edit))
                {
                    <a href="/content/projects/new"><i data-lucide="briefcase"></i>Portfolio project</a>
                    <a href="/content/posts/new"><i data-lucide="pen-line"></i>Blog post</a>
                    <a href="/content/services/new"><i data-lucide="layers"></i>Service</a>
                }
                @if (User.Has(Permissions.Websites.Manage)) { <a href="/websites/new"><i data-lucide="globe"></i>Website</a> }
                @if (User.Has(Permissions.Team.Manage)) { <a href="/team/new"><i data-lucide="user-round-plus"></i>Team member</a> }
            </div>
        </div>
    }
</div>
