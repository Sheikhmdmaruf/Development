@model List<PortfolioAdmin.Web.ViewComponents.NavGroup>
@{
    var path = Context.Request.Path.Value?.TrimEnd('/') ?? "";
    // Longest matching href wins, so /team/activity doesn't also light up /team.
    var all = Model.SelectMany(g => g.Items).Select(i => i.Href).ToList();
    var active = all.Where(h => h == "/" ? path == "" : path == h || path.StartsWith(h + "/"))
                    .OrderByDescending(h => h.Length).FirstOrDefault();
}
<aside class="sidebar" aria-label="Main navigation">
    <a class="brand" href="/" style="color:inherit;text-decoration:none">
        <div class="brand-mark">M</div>
        <div class="brand-name">Maruf Admin<small>Business workspace</small></div>
    </a>
    <nav class="nav">
        @foreach (var g in Model)
        {
            <div class="nav-group">
                <span class="eyebrow">@g.Label</span>
                @foreach (var i in g.Items)
                {
                    <a href="@i.Href" class="@(i.Href == active ? "active" : null)" title="@i.Label" aria-current="@(i.Href == active ? "page" : null)">
                        <i data-lucide="@i.Icon"></i><span>@i.Label</span>
                        @if (i.Count is int n) { <em class="count @(i.SoftCount ? "soft" : null)" style="font-style:normal">@(n > 99 ? "99+" : n)</em> }
                    </a>
                }
            </div>
        }
    </nav>
    <div class="sidebar-foot">
        <a class="me" href="/account/profile">
            <span class="avatar" style="@Ui.AvatarStyle(User.DisplayName())">@User.Initials()</span>
            <span class="who"><b class="truncate">@User.DisplayName()</b><span>@(User.IsSuperAdmin() ? "Super Admin" : string.Join(", ", User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value)))</span></span>
        </a>
    </div>
</aside>
