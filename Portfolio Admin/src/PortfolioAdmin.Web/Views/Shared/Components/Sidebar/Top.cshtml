@model List<PortfolioAdmin.Web.ViewComponents.NavGroup>
@{
    var path = Context.Request.Path.Value?.TrimEnd('/') ?? "";
    var all = Model.SelectMany(g => g.Items).Select(i => i.Href).ToList();
    var active = all.Where(h => h == "/" ? path == "" : path == h || path.StartsWith(h + "/")).OrderByDescending(h => h.Length).FirstOrDefault();
}
@* Top navigation: the first group as tabs, every other group as a dropdown. *@
<nav class="topnav" aria-label="Main navigation">
    @foreach (var i in Model[0].Items)
    {
        <a href="@i.Href" class="@(i.Href == active ? "active" : null)" aria-current="@(i.Href == active ? "page" : null)"><i data-lucide="@i.Icon" class="sm"></i>@i.Label</a>
    }
    @foreach (var g in Model.Skip(1))
    {
        var groupActive = g.Items.Any(i => i.Href == active);
        var count = g.Items.Where(i => !i.SoftCount).Sum(i => i.Count ?? 0);
        <div class="dropdown @(groupActive ? "has-active" : null)">
            <button type="button" data-dropdown-toggle aria-haspopup="menu" aria-expanded="false">
                @g.Label @if (count > 0) { <span class="count">@(count > 99 ? "99+" : count)</span> }<i data-lucide="chevron-down" class="sm"></i>
            </button>
            <div class="menu left" role="menu">
                @foreach (var i in g.Items)
                {
                    <a href="@i.Href" class="@(i.Href == active ? "active" : null)"><i data-lucide="@i.Icon"></i>@i.Label
                        @if (i.Count is int n) { <span class="count @(i.SoftCount ? "soft" : null)" style="margin-left:auto">@(n > 99 ? "99+" : n)</span> }
                    </a>
                }
            </div>
        </div>
    }
</nav>
