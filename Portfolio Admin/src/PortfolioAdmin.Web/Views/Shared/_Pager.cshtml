@model PagerModel
@{
    string Link(int p)
    {
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Context.Request.QueryString.Value)
            .ToDictionary(k => k.Key, v => (string?)v.Value.ToString());
        q["page"] = p.ToString();
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(Context.Request.Path, q);
    }
    var from = Math.Max(1, Model.Page - 2);
    var to = Math.Min(Model.Pages, from + 4);
}
@if (Model.Total > 0)
{
    <nav class="pager" aria-label="Pagination">
        <span>Showing @Model.From–@Model.To of @Model.Total</span>
        @if (Model.Pages > 1)
        {
            <div class="pages">
                @if (Model.Page > 1) { <a href="@Link(Model.Page - 1)" aria-label="Previous page"><i data-lucide="chevron-left" class="sm"></i></a> }
                @for (var p = from; p <= to; p++)
                {
                    if (p == Model.Page) { <span class="cur" aria-current="page">@p</span> } else { <a href="@Link(p)">@p</a> }
                }
                @if (Model.Page < Model.Pages) { <a href="@Link(Model.Page + 1)" aria-label="Next page"><i data-lucide="chevron-right" class="sm"></i></a> }
            </div>
        }
    </nav>
}
