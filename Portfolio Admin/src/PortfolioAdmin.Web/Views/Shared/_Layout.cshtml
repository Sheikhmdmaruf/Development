@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var title = ViewData["Title"] as string ?? "Dashboard";
    var csrf = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="@csrf">
    <title>@title · Maruf Admin</title>
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true">
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml">
</head>
<body>
<div class="app">
    @await Component.InvokeAsync("Sidebar")
    <div class="scrim"></div>

    <div class="main">
        <header class="topbar">
            <button class="icon-btn mobile-only" data-sidebar-open aria-label="Open menu"><i data-lucide="menu"></i></button>
            <button class="icon-btn desktop-only" data-sidebar-collapse aria-label="Collapse sidebar"><i data-lucide="panel-left"></i></button>
            <button class="search-trigger" data-palette-open type="button" aria-label="Search">
                <i data-lucide="search"></i><span>Search contacts, content, websites…</span><kbd>Ctrl K</kbd>
            </button>
            <div class="spacer"></div>

            <div class="dropdown">
                <button class="btn btn-primary btn-sm" data-dropdown-toggle aria-haspopup="menu" aria-expanded="false"><i data-lucide="plus"></i><span class="desktop-only">Create</span></button>
                <div class="menu" role="menu">
                    @if (User.Has(Permissions.Contacts.Create)) { <a href="/contacts/new"><i data-lucide="user-plus"></i>Contact</a> }
                    @if (User.Has(Permissions.Content.Edit))
                    {
                        <a href="/content/projects/new"><i data-lucide="briefcase"></i>Portfolio project</a>
                        <a href="/content/posts/new"><i data-lucide="pen-line"></i>Blog post</a>
                        <a href="/content/services/new"><i data-lucide="layers"></i>Service</a>
                    }
                    @if (User.Has(Permissions.Websites.Manage)) { <a href="/websites/new"><i data-lucide="globe"></i>Website</a> }
                    @if (User.Has(Permissions.Team.Manage)) { <div class="sep"></div><a href="/team/new"><i data-lucide="user-round-plus"></i>Team member</a> }
                    @if (!User.HasAny(Permissions.Contacts.Create, Permissions.Content.Edit, Permissions.Websites.Manage, Permissions.Team.Manage)) { <div class="menu-head small faint">Nothing you can create yet.</div> }
                </div>
            </div>

            <button class="icon-btn" data-theme-toggle aria-label="Toggle theme"><i data-lucide="moon"></i></button>

            <div class="dropdown" data-notifications>
                <button class="icon-btn" data-dropdown-toggle aria-label="Notifications" aria-haspopup="true">
                    <i data-lucide="bell"></i>
                    @await Component.InvokeAsync("UnreadDot")
                </button>
                <div class="menu notif-menu">
                    <div class="row between" style="padding:12px 16px;border-bottom:1px solid var(--border)">
                        <h3>Notifications</h3>
                        <form method="post" action="/notifications/read-all"><button class="btn btn-text btn-sm">Mark all read</button></form>
                    </div>
                    <div class="notif-list"><div style="padding:16px" class="stack-sm"><div class="skeleton" style="height:40px"></div><div class="skeleton" style="height:40px"></div></div></div>
                    <a href="/notifications" class="row" style="justify-content:center;padding:12px;border-top:1px solid var(--border);font-weight:600">View all</a>
                </div>
            </div>

            <div class="dropdown">
                <button class="icon-btn" data-dropdown-toggle aria-label="Account menu" style="width:auto;padding:0 4px">
                    <span class="avatar sm" style="@Ui.AvatarStyle(User.DisplayName())">@User.Initials()</span>
                </button>
                <div class="menu">
                    <div class="menu-head"><b>@User.DisplayName()</b><div class="small faint truncate">@User.Identity?.Name</div></div>
                    <div class="sep"></div>
                    <a href="/account/profile"><i data-lucide="user-round"></i>My profile</a>
                    <a href="/account/password"><i data-lucide="key-round"></i>Change password</a>
                    <a href="/account/notifications"><i data-lucide="bell-ring"></i>Notification settings</a>
                    <div class="sep"></div>
                    <div class="row" style="padding:4px 10px;gap:4px">
                        <span class="small faint grow">Theme</span>
                        <div class="seg">
                            <button type="button" data-theme-set="light" title="Light" aria-label="Light theme"><i data-lucide="sun" class="sm"></i></button>
                            <button type="button" data-theme-set="dark" title="Dark" aria-label="Dark theme"><i data-lucide="moon" class="sm"></i></button>
                            <button type="button" data-theme-set="system" title="System" aria-label="System theme"><i data-lucide="monitor" class="sm"></i></button>
                        </div>
                    </div>
                    <div class="sep"></div>
                    <form method="post" action="/logout"><button class="danger"><i data-lucide="log-out"></i>Sign out</button></form>
                </div>
            </div>
        </header>

        <main class="page" id="content">
            @RenderBody()
        </main>
    </div>
</div>

@if (TempData["toast.success"] is string ok) { <span hidden data-toast="@ok" data-kind="success"></span> }
@if (TempData["toast.error"] is string err) { <span hidden data-toast="@err" data-kind="error"></span> }

<dialog class="modal" id="confirm-dialog" aria-labelledby="confirm-title">
    <div class="modal-head"><h2 id="confirm-title">Are you sure?</h2><button class="icon-btn" data-dialog-close aria-label="Close"><i data-lucide="x"></i></button></div>
    <div class="modal-body"><p id="confirm-text" class="muted"></p></div>
    <div class="modal-foot"><button class="btn btn-ghost" data-dialog-close>Cancel</button><button class="btn btn-danger" id="confirm-ok">Confirm</button></div>
</dialog>

<dialog class="modal palette" id="palette" aria-label="Search">
    <div class="palette-input"><i data-lucide="search"></i><input type="search" placeholder="Search contacts, websites, projects, posts…" autocomplete="off"><kbd>Esc</kbd></div>
    <div class="palette-results"></div>
</dialog>
<template id="palette-default">
    <div class="group eyebrow">Jump to</div>
    <a href="/"><i data-lucide="layout-dashboard"></i><div class="grow">Overview</div></a>
    @if (User.Has(Permissions.Contacts.View)) { <a href="/contacts"><i data-lucide="contact"></i><div class="grow">Contacts</div></a><a href="/leads"><i data-lucide="kanban"></i><div class="grow">Leads board</div></a> }
    @if (User.Has(Permissions.Content.View)) { <a href="/content/projects"><i data-lucide="briefcase"></i><div class="grow">Portfolio projects</div></a><a href="/content/posts"><i data-lucide="pen-line"></i><div class="grow">Blog posts</div></a> }
    @if (User.Has(Permissions.Websites.View)) { <a href="/websites"><i data-lucide="globe"></i><div class="grow">Websites</div></a> }
    <a href="/notifications"><i data-lucide="bell"></i><div class="grow">Notifications</div></a>
</template>

<script src="~/lib/lucide.min.js"></script>
@if (ViewData["Charts"] is true) { <script src="~/lib/chart.umd.js"></script> }
<script src="~/js/app.js" asp-append-version="true"></script>
</body>
</html>
