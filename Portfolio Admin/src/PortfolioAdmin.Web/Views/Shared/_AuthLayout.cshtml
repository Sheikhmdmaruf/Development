<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(ViewData["Title"] ?? "Sign in") · Maruf Admin</title>
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true">
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml">
</head>
<body>
<main class="auth">
    <div class="card auth-card">
        <div class="brand"><div class="brand-mark">M</div><div class="brand-name">Maruf Admin<small>Business workspace</small></div></div>
        @RenderBody()
    </div>
</main>
@if (TempData["toast.success"] is string ok) { <span hidden data-toast="@ok" data-kind="success"></span> }
<script src="~/lib/lucide.min.js"></script>
<script src="~/js/app.js" asp-append-version="true"></script>
</body>
</html>
