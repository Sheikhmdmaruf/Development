@model List<AppRole>
@{ ViewData["Title"] = "Roles & permissions"; var counts = (Dictionary<string, int>)ViewBag.Counts; var perms = (Dictionary<string, int>)ViewBag.Perms; var total = Permissions.All.Count(); }
<div class="page-head">
    <div><span class="eyebrow">System</span><h1>Roles &amp; permissions</h1><p>Each member has one role. A role is a set of permissions.</p></div>
    <div class="page-actions"><button class="btn btn-primary" data-dialog-open="new-role"><i data-lucide="plus"></i>New role</button></div>
</div>
<div class="grid cols-2">
    @foreach (var r in Model)
    {
        var isSuper = r.Name == Permissions.SuperAdminRole;
        var n = isSuper ? total : perms.GetValueOrDefault(r.Id);
        <a class="card pad stack-sm" href="/settings/roles/@r.Id">
            <div class="row between">
                <div class="row"><span class="stat-icon @(isSuper ? "tone-coral" : "tone-blue")"><i data-lucide="@(isSuper ? "crown" : "shield")"></i></span><h3>@r.Name</h3></div>
                @if (r.IsSystem) { <span class="tag tone-slate">Built-in</span> }
            </div>
            <p class="small muted">@r.Description</p>
            <div class="progress"><span style="width:@(n * 100 / total)%"></span></div>
            <div class="row between small faint"><span>@n of @total permissions</span><span>@counts.GetValueOrDefault(r.Id) member@(counts.GetValueOrDefault(r.Id) == 1 ? "" : "s")</span></div>
        </a>
    }
</div>

<dialog class="modal" id="new-role" aria-labelledby="new-role-title">
    <form method="post" action="/settings/roles/new">
        <div class="modal-head"><h2 id="new-role-title">New role</h2><button type="button" class="icon-btn" data-dialog-close aria-label="Close"><i data-lucide="x"></i></button></div>
        <div class="modal-body stack">
            <div class="field"><label for="role-name">Name</label><input id="role-name" name="name" class="input" required maxlength="60" placeholder="e.g. Content Editor" autofocus></div>
            <div class="field"><label for="role-desc">Description</label><input id="role-desc" name="description" class="input" maxlength="300"></div>
            <p class="small faint">Starts with the Team Member permissions. You choose the rest on the next page.</p>
        </div>
        <div class="modal-foot"><button type="button" class="btn btn-ghost" data-dialog-close>Cancel</button><button class="btn btn-primary">Create role</button></div>
    </form>
</dialog>
