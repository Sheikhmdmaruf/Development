@model AppRole
@{
    ViewData["Title"] = Model.Name;
    var granted = (HashSet<string>)ViewBag.Granted;
    var members = (IList<AppUser>)ViewBag.Members;
    var isSuper = Model.Name == Permissions.SuperAdminRole;
}
<div class="crumbs"><a href="/settings/roles">Roles &amp; permissions</a><i data-lucide="chevron-right" class="sm"></i><span>@Model.Name</span></div>
<form method="post" action="/settings/roles/@Model.Id">
    <div class="page-head">
        <div><h1>@Model.Name</h1><p>@(isSuper ? "Super Admin always has every permission and can't be limited." : "Tick what members of this role are allowed to do.")</p></div>
        <div class="page-actions">
            @if (!Model.IsSystem) { <button class="btn btn-danger" formaction="/settings/roles/@Model.Id/delete" data-confirm="Delete the role @Model.Name?" data-confirm-label="Delete" formnovalidate><i data-lucide="trash-2"></i>Delete role</button> }
            @if (!isSuper) { <button class="btn btn-primary"><i data-lucide="save"></i>Save permissions</button> }
        </div>
    </div>
    <div class="grid cols-3">
        <div class="card span-2">
            @if (!isSuper)
            {
                <div class="card-body" style="padding-bottom:0"><div class="field"><label for="desc">Description</label><input id="desc" name="description" class="input" value="@Model.Description" maxlength="300"></div></div>
            }
            <div style="margin-top:12px">
                @foreach (var (module, items) in Permissions.Groups)
                {
                    <div class="perm-group">
                        <div><b>@module</b></div>
                        <div class="perm-items">
                            @foreach (var (key, label) in items)
                            {
                                <label class="check"><input type="checkbox" name="permissions" value="@key" checked="@(isSuper || granted.Contains(key))" disabled="@isSuper"> @label</label>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="card" style="align-self:start">
            <div class="card-head"><h2>Members</h2><span class="small faint">@members.Count</span></div>
            <div class="list">
                @if (members.Count == 0) { <div class="empty small"><p>Nobody has this role.</p></div> }
                @foreach (var u in members) { <a class="list-item" href="/team/@u.Id"><span class="avatar sm" style="@Ui.AvatarStyle(u.FullName)">@u.Initials</span><span class="grow truncate">@u.FullName</span></a> }
            </div>
        </div>
    </div>
</form>
