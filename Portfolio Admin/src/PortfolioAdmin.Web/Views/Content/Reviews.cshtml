@model List<CmsReview>
@{ ViewData["Title"] = "Reviews"; var canEdit = User.Has(Permissions.Content.Edit); }
<partial name="_Head" model="@(("reviews", "Reviews", "Client testimonials on the home page. Drag to reorder.", (string?)"Add review"))" />
@if (Model.Count == 0) { <div class="card"><div class="empty"><div class="empty-icon"><i data-lucide="quote"></i></div><h3>No reviews yet</h3></div></div> }
<div class="card">
    <div class="table-wrap"><table class="table">
        <tbody data-sortable="@(canEdit ? "/content/reviews/reorder" : null)">
            @foreach (var r in Model)
            {
                <tr data-id="@r.Id" draggable="@(canEdit ? "true" : "false")">
                    @if (canEdit) { <td style="width:32px"><i data-lucide="grip-vertical" class="sortable-handle sm"></i></td> }
                    <td>
                        <div class="row" style="align-items:flex-start">
                            <span class="avatar" style="--av1:@r.Color1;--av2:@r.Color2">@Ui.Initials(r.Name)</span>
                            <div class="grow"><p style="font-style:italic">“@r.Quote”</p><div class="small muted" style="margin-top:4px"><b>@r.Name</b> · @r.Role, @r.Company</div></div>
                        </div>
                    </td>
                    <td style="width:90px">@if (r.IsPublished) { <span class="badge tone-green">Live</span> } else { <span class="badge tone-slate">Hidden</span> }</td>
                    <td class="actions" style="width:120px"><partial name="_RowActions" model="@(("reviews", r.Id, r.IsPublished, "review by " + r.Name))" /></td>
                </tr>
            }
        </tbody>
    </table></div>
</div>
