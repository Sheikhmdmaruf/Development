@model (string Name, string Label, string? Value, string? Hint)
<div class="field">
    <span class="label">@Model.Label</span>
    <div class="upload" data-upload>
        <div class="preview">@if (!string.IsNullOrEmpty(Model.Value)) { <img src="@Model.Value" alt=""> } else { <i data-lucide="image"></i> }</div>
        <div class="stack-sm grow">
            <input class="input input-sm mono" name="@Model.Name" value="@Model.Value" data-upload-value placeholder="/images/photo.jpg or upload" aria-label="@Model.Label path">
            <div class="row">
                @if (User.Has(Permissions.Content.Edit)) { <label class="btn btn-ghost btn-sm"><i data-lucide="upload"></i>Upload<input type="file" accept="image/jpeg,image/png,image/gif,image/webp" hidden></label> }
                <button type="button" class="btn btn-text btn-sm" data-upload-clear>Clear</button>
                @if (Model.Hint is not null) { <span class="small faint">@Model.Hint</span> }
            </div>
        </div>
    </div>
</div>
