@{
    ViewData["Title"] = "Site settings";
    var values = (Dictionary<string, string>)ViewBag.Values;
    var sites = (List<Website>)ViewBag.ContentSites;
}
<partial name="_Head" model="@(("settings", "Site settings", "Contact details, links and other texts used across the portfolio.", (string?)null))" />
@if (sites.Count == 0)
{
    <div class="callout tone-amber" style="margin-bottom:16px"><i data-lucide="plug-zap"></i><div>No website can read this content yet. Open <a href="/websites">Websites</a> and turn on <b>Can read portfolio content</b> for your portfolio.</div></div>
}
else
{
    <div class="callout tone-green" style="margin-bottom:16px"><i data-lucide="radio"></i><div>Live on: @string.Join(", ", sites.Select(s => s.Name)). Changes appear on the site within about a minute.</div></div>
}
<form method="post" action="/content/settings" class="stack" style="max-width:900px">
    @foreach (var group in SiteKeys.Fields.GroupBy(f => f.Group))
    {
        <div class="card">
            <div class="card-head"><h2>@group.Key</h2></div>
            <div class="card-body form-grid">
                @foreach (var (key, label, _, multiline) in group)
                {
                    <div class="field @(multiline ? "full" : null)">
                        <label for="@key">@label</label>
                        @if (multiline) { <textarea id="@key" name="@key" class="textarea" rows="6">@values.GetValueOrDefault(key)</textarea> }
                        else { <input id="@key" name="@key" class="input" value="@values.GetValueOrDefault(key)" type="@(key.EndsWith("_url") ? "url" : key == SiteKeys.ContactEmail ? "email" : "text")"> }
                    </div>
                }
            </div>
        </div>
    }
    @if (User.Has(Permissions.Content.Edit)) { <div class="form-actions"><button class="btn btn-primary"><i data-lucide="save"></i>Save settings</button></div> }
</form>
