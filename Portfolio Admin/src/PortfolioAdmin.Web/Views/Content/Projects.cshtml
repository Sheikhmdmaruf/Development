@model List<CmsProject>
@{ ViewData["Title"] = "Projects"; var canEdit = User.Has(Permissions.Content.Edit); }
<partial name="_Head" model="@(("projects", "Projects", "Your work on the portfolio. The first 3 published projects show on the home page. Drag to reorder.", (string?)"New project"))" />
<div class="card">
    @if (Model.Count == 0)
    {
        <div class="empty"><div class="empty-icon"><i data-lucide="briefcase"></i></div><h3>No projects yet</h3><p>Add your first project to show it on the portfolio.</p></div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead><tr>@if (canEdit) { <th style="width:32px"></th> }<th>Project</th><th class="hide-sm">Type</th><th class="hide-sm">Year</th><th class="hide-sm">Case study</th><th>Status</th><th></th></tr></thead>
                <tbody data-sortable="@(canEdit ? "/content/projects/reorder" : null)">
                    @{ var i = 0; }
                    @foreach (var p in Model)
                    {
                        var hasCase = p.StepsJson is not null || p.MetricsJson is not null || p.Client is not null;
                        <tr data-id="@p.Id" draggable="@(canEdit ? "true" : "false")">
                            @if (canEdit) { <td><i data-lucide="grip-vertical" class="sortable-handle sm"></i></td> }
                            <td>
                                <a class="row row-link" href="/content/projects/@p.Id">
                                    <span class="thumb" style="--c1:@p.Color1;--c2:@p.Color2">@if (!string.IsNullOrEmpty(p.ImagePath)) { <img src="@p.ImagePath" alt=""> }</span>
                                    <span style="min-width:0"><b class="truncate" style="display:block">@p.Title</b><span class="small faint truncate" style="display:block">@p.Summary</span></span>
                                </a>
                            </td>
                            <td class="hide-sm"><span class="tag tone-slate">@p.Category</span> @if (p.Badge is not null) { <span class="tag tone-coral">@p.Badge</span> }</td>
                            <td class="hide-sm small muted">@p.Year</td>
                            <td class="hide-sm">@if (hasCase) { <span class="small" style="color:var(--success)"><i data-lucide="check" class="sm"></i> Written</span> } else { <span class="small faint">Overview only</span> }</td>
                            <td>
                                @if (p.IsPublished) { <span class="badge tone-green">@(p.IsPublished && i < 3 ? "Live · home" : "Live")</span> } else { <span class="badge tone-slate">Hidden</span> }
                            </td>
                            <td class="actions"><partial name="_RowActions" model="@(("projects", p.Id, p.IsPublished, p.Title))" /></td>
                        </tr>
                        if (p.IsPublished) { i++; }
                    }
                </tbody>
            </table>
        </div>
    }
</div>
