@model (string Kind, int Id, bool Published, string Label)
<div class="row" style="justify-content:flex-end;gap:2px">
    <a class="btn btn-text btn-sm btn-icon" href="/content/@Model.Kind/@Model.Id" title="Edit" aria-label="Edit @Model.Label"><i data-lucide="pencil" class="sm"></i></a>
    @if (User.Has(Permissions.Content.Edit))
    {
        <form method="post" action="/content/@Model.Kind/@Model.Id/toggle"><button class="btn btn-text btn-sm btn-icon" title="@(Model.Published ? "Hide from portfolio" : "Publish")" aria-label="@(Model.Published ? "Unpublish" : "Publish") @Model.Label"><i data-lucide="@(Model.Published ? "eye-off" : "eye")" class="sm"></i></button></form>
    }
    @if (User.Has(Permissions.Content.Delete))
    {
        <form method="post" action="/content/@Model.Kind/@Model.Id/delete" data-confirm="Delete &quot;@Model.Label&quot;? It disappears from the portfolio. This can't be undone." data-confirm-label="Delete"><button class="btn btn-text btn-sm btn-icon" title="Delete" aria-label="Delete @Model.Label"><i data-lucide="trash-2" class="sm"></i></button></form>
    }
</div>
