@model CmsPost
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New post" : Model.Title;
}
<div class="crumbs"><a href="/content/posts">Blog posts</a><i data-lucide="chevron-right" class="sm"></i><span>@(isNew ? "New" : Model.Title)</span></div>
<form method="post" action="@(isNew ? "/content/posts/new" : $"/content/posts/{Model.Id}")">
    <div class="page-head">
        <div><h1>@(isNew ? "New blog post" : "Edit post")</h1><p>Article page at <code>/blog/@(string.IsNullOrEmpty(Model.Slug) ? "…" : Model.Slug)</code></p></div>
        <div class="page-actions">
            <label class="switch"><input type="checkbox" asp-for="IsPublished"><span class="small"><b>Published</b></span></label>
            <a class="btn btn-ghost" href="/content/posts">Cancel</a>
            @if (User.Has(Permissions.Content.Edit)) { <button class="btn btn-primary"><i data-lucide="save"></i>Save</button> }
        </div>
    </div>
    <div asp-validation-summary="ModelOnly" style="margin-bottom:16px"></div>
    <div class="grid cols-3">
        <div class="span-2 stack">
            <div class="card">
                <div class="card-body stack">
                    <div class="field"><label asp-for="Title"></label><input asp-for="Title" class="input" id="title" style="font-size:18px;height:48px" autofocus><span asp-validation-for="Title"></span></div>
                    <div class="field"><label asp-for="Summary">Summary (under the title)</label><input asp-for="Summary" class="input"></div>
                    <div class="field">
                        <div class="row between"><label asp-for="Body">Article</label><span class="small faint"><code>## Heading</code> · <code>### Small heading</code> · <code>&gt; Quote</code> · <code>- List item</code> · blank line = new paragraph</span></div>
                        <textarea asp-for="Body" class="textarea tall" placeholder="Write your article here…"></textarea>
                        <span class="hint">Leave empty to show "coming soon". Not used when an external link is set.</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="stack" style="align-self:start">
            <div class="card pad stack">
                <div class="field"><label asp-for="Slug">URL slug</label><input asp-for="Slug" class="input mono" data-slug-from="#title" placeholder="auto from title"><span asp-validation-for="Slug"></span></div>
                <div class="field">
                    <label asp-for="Category"></label>
                    <input asp-for="Category" class="input" list="cats">
                    <datalist id="cats"><option value="UI/UX"></option><option value="Web Design"></option><option value="Freelancing"></option></datalist>
                    <span class="hint">Must match a Blog page filter: UI/UX, Web Design, Freelancing.</span>
                </div>
                <div class="row">
                    <div class="field grow"><label asp-for="PublishDate">Date</label><input asp-for="PublishDate" type="date" class="input" value="@Model.PublishDate.ToString("yyyy-MM-dd")"></div>
                    <div class="field grow"><label asp-for="ReadTime">Read time</label><input asp-for="ReadTime" class="input" placeholder="6 min"></div>
                </div>
                <div class="field">
                    <label asp-for="Type">Placeholder art</label>
                    <select asp-for="Type" class="select"><option value="">Default</option><option value="web">Website</option><option value="app">App</option><option value="dash">Dashboard</option></select>
                </div>
                <div class="row">
                    <label class="field grow"><span class="label">Colour 1</span><input type="color" asp-for="Color1" class="input"></label>
                    <label class="field grow"><span class="label">Colour 2</span><input type="color" asp-for="Color2" class="input"></label>
                </div>
                <partial name="_ImageField" model="@(("ImagePath", "Cover image", Model.ImagePath, (string?)null))" />
                <span asp-validation-for="ImagePath"></span>
                <div class="field"><label asp-for="ExternalUrl">External link (optional)</label><input asp-for="ExternalUrl" class="input" placeholder="https://medium.com/…"><span class="hint">Opens this link instead of an article page.</span><span asp-validation-for="ExternalUrl"></span></div>
            </div>
        </div>
    </div>
</form>
