@model CmsProject
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New project" : Model.Title;
    var canEdit = User.Has(Permissions.Content.Edit);
    var metricFields = Json.Serialize(new object[] {
        new { key = "label", label = "Label", placeholder = "Checkout" },
        new { key = "value", label = "Value", placeholder = "-35%" },
        new { key = "cap", label = "Caption", placeholder = "fewer steps to place an order" },
        new { key = "icon", label = "Icon", options = new[] { "cart", "clock", "grid", "star" } },
    }).ToString();
    var stepFields = Json.Serialize(new object[] {
        new { key = "title", label = "Title", placeholder = "Challenge", wide = true },
        new { key = "body", label = "Paragraphs (blank line between paragraphs)", multiline = true, rows = 5, paragraphs = true, wide = true },
    }).ToString();
    var galleryFields = Json.Serialize(new object[] { new { key = "src", label = "Image path or link", placeholder = "/images/food-1.jpg", wide = true } }).ToString();
}
<div class="crumbs"><a href="/content/projects">Projects</a><i data-lucide="chevron-right" class="sm"></i><span>@(isNew ? "New" : Model.Title)</span></div>
<form method="post" action="@(isNew ? "/content/projects/new" : $"/content/projects/{Model.Id}")">
    <div class="page-head">
        <div><h1>@(isNew ? "New project" : Model.Title)</h1><p>Card on the Work page + the case study page at <code>/project/@(string.IsNullOrEmpty(Model.Slug) ? "…" : Model.Slug)</code></p></div>
        <div class="page-actions">
            <label class="switch"><input type="checkbox" asp-for="IsPublished"><span class="small"><b>Published</b></span></label>
            <a class="btn btn-ghost" href="/content/projects">Cancel</a>
            @if (canEdit) { <button class="btn btn-primary"><i data-lucide="save"></i>Save</button> }
        </div>
    </div>
    <div asp-validation-summary="ModelOnly" style="margin-bottom:16px"></div>

    <div class="grid cols-3">
        <div class="span-2 stack">
            <div class="card">
                <div class="card-head"><div><h2>Project card</h2><p>Shown on the home page and Work page</p></div></div>
                <div class="card-body form-grid">
                    <div class="field full"><label asp-for="Title"></label><input asp-for="Title" class="input" id="title" autofocus><span asp-validation-for="Title"></span></div>
                    <div class="field"><label asp-for="Slug">URL slug</label><input asp-for="Slug" class="input mono" data-slug-from="#title" placeholder="auto from title"><span asp-validation-for="Slug"></span></div>
                    <div class="field">
                        <label asp-for="Type">Type (for filters)</label>
                        <select asp-for="Type" class="select"><option value="web">Website</option><option value="app">Mobile app</option><option value="dash">Dashboard</option></select>
                        <span asp-validation-for="Type"></span>
                    </div>
                    <div class="field"><label asp-for="Category">Category label</label><input asp-for="Category" class="input" placeholder="Website"></div>
                    <div class="field"><label asp-for="Year"></label><input asp-for="Year" class="input" placeholder="2026"></div>
                    <div class="field"><label asp-for="Highlight">Highlight pill</label><input asp-for="Highlight" class="input" placeholder="Landing + inner pages"></div>
                    <div class="field"><label asp-for="Badge">Badge (optional)</label><input asp-for="Badge" class="input" placeholder="Featured"></div>
                    <div class="field full"><label asp-for="Summary">One-line summary</label><input asp-for="Summary" class="input"><span asp-validation-for="Summary"></span></div>
                    <div class="field full"><label asp-for="ExternalUrl">External link (Dribbble, Behance, live site)</label><input asp-for="ExternalUrl" class="input" placeholder="https://dribbble.com/shots/…"><span asp-validation-for="ExternalUrl"></span></div>
                    <div class="full"><partial name="_ImageField" model="@(("ImagePath", "Card image", Model.ImagePath, (string?)"Leave empty to use the colour gradient"))" /><span asp-validation-for="ImagePath"></span></div>
                    <div class="full"><partial name="_ImageField" model="@(("CoverPath", "Case study cover (optional)", Model.CoverPath, (string?)null))" /><span asp-validation-for="CoverPath"></span></div>
                </div>
            </div>

            <div class="card">
                <div class="card-head"><div><h2>Case study</h2><p>Optional. Without it the project page shows an overview only.</p></div></div>
                <div class="card-body stack">
                    <div class="form-grid">
                        <div class="field"><label asp-for="Client"></label><input asp-for="Client" class="input" placeholder="Food delivery startup"></div>
                        <div class="field"><label asp-for="Role">My role</label><input asp-for="Role" class="input" placeholder="Product designer (UI/UX)"></div>
                        <div class="field"><label asp-for="Duration"></label><input asp-for="Duration" class="input" placeholder="6 weeks"></div>
                        <div class="field"><label asp-for="Tools"></label><input asp-for="Tools" class="input" placeholder="Figma, FigJam, Maze"></div>
                        <div class="field full"><label asp-for="Team"></label><input asp-for="Team" class="input" placeholder="1 designer, 1 PM, 2 developers"></div>
                    </div>
                    <div class="section-title"><h3>Metrics</h3><span class="small faint">3 cards under the header</span></div>
                    <partial name="_Repeater" model="@(("MetricsJson", Model.MetricsJson, "object", metricFields, "Add metric"))" />
                    <div class="section-title"><h3>Story steps</h3><span class="small faint">Numbered panels: Challenge, Process, Result…</span></div>
                    <partial name="_Repeater" model="@(("StepsJson", Model.StepsJson, "object", stepFields, "Add step"))" />
                    <div class="section-title"><h3>Gallery</h3><span class="small faint">1 wide + 2 half images at the end</span></div>
                    <partial name="_Repeater" model="@(("GalleryJson", Model.GalleryJson, "string", galleryFields, "Add image"))" />
                    <p class="small faint">Tip: upload an image in the card image field above, copy its path, then paste it here.</p>
                </div>
            </div>
        </div>

        <div class="stack" style="align-self:start;position:sticky;top:84px">
            <div class="card pad stack">
                <span class="eyebrow">Card colours</span>
                <p class="small muted">Used as the gradient when there's no image.</p>
                <div class="row">
                    <label class="field grow"><span class="label">Colour 1</span><input type="color" asp-for="Color1" class="input"></label>
                    <label class="field grow"><span class="label">Colour 2</span><input type="color" asp-for="Color2" class="input"></label>
                </div>
                <div class="thumb" style="width:100%;height:110px;border-radius:12px;--c1:@Model.Color1;--c2:@Model.Color2"></div>
            </div>
            @if (!isNew)
            {
                <div class="card pad stack-sm">
                    <span class="eyebrow">Info</span>
                    <div class="small muted">Last updated @Time.Ago(Model.UpdatedAt)</div>
                </div>
            }
        </div>
    </div>
</form>
