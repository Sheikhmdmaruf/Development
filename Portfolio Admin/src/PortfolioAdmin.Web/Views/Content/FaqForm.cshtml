@model CmsFaq
@{ var isNew = Model.Id == 0; ViewData["Title"] = isNew ? "Add question" : "Edit question"; }
<div class="crumbs"><a href="/content/faq">FAQ</a><i data-lucide="chevron-right" class="sm"></i><span>@(isNew ? "New" : "Edit")</span></div>
<div class="page-head"><div><h1>@(isNew ? "Add a question" : "Edit question")</h1></div></div>
<form method="post" action="@(isNew ? "/content/faq/new" : $"/content/faq/{Model.Id}")" class="card" style="max-width:760px">
    <div class="card-body stack">
        <div asp-validation-summary="ModelOnly"></div>
        <div class="form-grid">
            <div class="field"><label asp-for="Pill">Pill label</label><input asp-for="Pill" class="input" placeholder="Timeline"></div>
            <label class="switch" style="align-self:end"><input type="checkbox" asp-for="IsPublished"><span><b>Published</b></span></label>
            <div class="field full"><label asp-for="Question"></label><input asp-for="Question" class="input" autofocus><span asp-validation-for="Question"></span></div>
            <div class="field full"><label asp-for="Answer"></label><textarea asp-for="Answer" class="textarea" rows="4"></textarea><span asp-validation-for="Answer"></span></div>
        </div>
        <div class="form-actions"><a class="btn btn-ghost" href="/content/faq">Cancel</a>@if (User.Has(Permissions.Content.Edit)) { <button class="btn btn-primary">Save question</button> }</div>
    </div>
</form>
